{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "debrief-collection-v1.0.0",
  "title": "Debrief STAC Collection",
  "description": "A STAC Collection with Debrief extension summaries",
  "type": "object",
  "required": ["type", "stac_version", "id", "description", "license", "extent", "links"],
  "properties": {
    "type": {
      "type": "string",
      "const": "Collection"
    },
    "stac_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "default": "proprietary"
    },
    "extent": {
      "$ref": "#/definitions/Extent"
    },
    "summaries": {
      "$ref": "#/definitions/Summaries"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Link"
      }
    }
  },
  "definitions": {
    "Extent": {
      "type": "object",
      "required": ["spatial", "temporal"],
      "properties": {
        "spatial": {
          "type": "object",
          "required": ["bbox"],
          "properties": {
            "bbox": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "number" }
              },
              "minItems": 1
            }
          }
        },
        "temporal": {
          "type": "object",
          "required": ["interval"],
          "properties": {
            "interval": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": ["string", "null"]
                }
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "Summaries": {
      "type": "object",
      "properties": {
        "debrief:vessel_classes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "debrief:tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "debrief:feature_tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "debrief:track_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "debrief:nationalities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      }
    },
    "Link": {
      "type": "object",
      "required": ["rel", "href"],
      "properties": {
        "rel": { "type": "string" },
        "href": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" }
      }
    }
  }
}
