;; Test fixture: all 4 sensor formats with track positions
;; Feature: 117-rep-sensor-import
;;
;; Track NELSON with SENSOR v1 lines (explicit DMS coords and NULL)
;; Track FRIGATE with SENSOR2, SENSOR3, and SENSORARC lines

;; Track positions for NELSON
951212 050000.000 NELSON   @C   22 11 10.63 N 21 41 52.37 W 269.7   2.0      0
951212 050100.000 NELSON   @C   22 11 10.58 N 21 42  2.98 W 269.7   2.0      0
951212 050200.000 NELSON   @C   22 11 10.51 N 21 42 14.81 W 269.9   2.0      0
951212 050300.000 NELSON   @C   22 11 10.51 N 21 42 27.27 W 268.7   2.0      0
951212 050400.000 NELSON   @C   22 11 10.28 N 21 42 40.33 W 270.6   2.0      0

;; Track positions for FRIGATE
951212 050000.000 FRIGATE  @A   22 15 20.00 N 21 45 30.00 W 180.0   5.0      0
951212 050100.000 FRIGATE  @A   22 15 10.00 N 21 45 30.00 W 180.0   5.0      0
951212 050200.000 FRIGATE  @A   22 15  0.00 N 21 45 30.00 W 180.0   5.0      0

;; SENSOR v1: NELSON with explicit DMS coordinates
;SENSOR: 951212 050000.000 NELSON @C 22 11 10.63 N 21 41 52.37 W 045.0 5000 TOWED_ARRAY contact_1
;SENSOR: 951212 050100.000 NELSON @C NULL 050.0 5500 TOWED_ARRAY contact_2
;SENSOR: 951212 050200.000 NELSON @C NULL 055.0 6000 TOWED_ARRAY contact_3

;; SENSOR v1: quoted track name
;SENSOR: 951212 050000.000 "NEL STYLE" @C NULL 090.0 3000 HULL_SONAR bow_contact

;; SENSOR2: FRIGATE with ambiguous bearing and frequency
;SENSOR2: 951212 050000.000 FRIGATE @A NULL 032.8 12000 240.5 169.4 NULL SENSOR_A first contact
;SENSOR2: 951212 050100.000 FRIGATE @A NULL 035.2 11500 NULL NULL NULL SENSOR_A second contact

;; SENSOR3: FRIGATE with accuracy fields (silently discarded)
;SENSOR3: 951212 050200.000 FRIGATE @A NULL 038.0 11000 242.0 170.0 5.0 2.0 NULL SENSOR_A third contact

;; SENSORARC: FRIGATE coverage zone
;SENSORARC 951212 050000.000 951212 050500.000 FRIGATE 270 90 0 5000
