{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://debrief.info/stac-extensions/debrief/v1.0.0/schema.json",
  "title": "Debrief STAC Extension",
  "description": "Extension properties for Debrief maritime tactical analysis STAC items",
  "type": "object",
  "required": ["type", "stac_version", "id", "geometry", "bbox", "properties", "links", "assets"],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://debrief.info/stac-extensions/debrief/v1.0.0/schema.json"
      }
    },
    "properties": {
      "type": "object",
      "properties": {
        "debrief:vessel_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(/[a-z0-9-]+){0,2}$"
          },
          "uniqueItems": true,
          "description": "Hierarchical vessel classification paths (e.g., surface/warship/frigate/type23)"
        },
        "debrief:tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Plot-level tags"
        },
        "debrief:feature_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Union of all feature-level tags from GeoJSON features"
        },
        "debrief:author": {
          "type": "string",
          "minLength": 1,
          "description": "Analyst who created the plot"
        },
        "debrief:track_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Names of all tracks in the plot"
        },
        "debrief:nationalities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Nationalities of vessels in the plot"
        }
      }
    }
  }
}
