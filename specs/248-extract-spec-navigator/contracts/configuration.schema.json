{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debrief.github.io/spec-navigator/schema/configuration.schema.json",
  "title": "spec-navigator Configuration",
  "description": "Parameters that adapt spec-navigator to a specific consumer repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo"],
  "properties": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "GitHub repository whose specs are rendered, in '<org>/<name>' form.",
      "examples": ["debrief/debrief-future", "acme/our-platform"]
    },
    "branch": {
      "type": ["string", "null"],
      "description": "Optional branch override. Null/absent means use the consumer repo's default branch.",
      "default": null
    },
    "specsPath": {
      "type": "string",
      "description": "Path under 'repo' where speckit feature directories live. Must not start with '/' or contain '..'.",
      "default": "specs",
      "pattern": "^(?!/)(?!.*\\.\\.).+$"
    },
    "featureDirPattern": {
      "type": "string",
      "description": "JavaScript-regex source matching a single feature directory name.",
      "default": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "artefactFilenames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "default": ["spec.md", "plan.md", "tasks.md", "research.md", "data-model.md", "quickstart.md"]
    },
    "artefactDirectories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "default": ["evidence", "contracts", "checklists"]
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mapping from navigator's internal status taxonomy to consumer GitHub label names.",
      "properties": {
        "draft":        { "type": "array", "items": { "type": "string" } },
        "in-progress":  { "type": "array", "items": { "type": "string" } },
        "complete":     { "type": "array", "items": { "type": "string" } }
      },
      "default": {
        "draft": ["status:draft"],
        "in-progress": ["status:in-progress", "implementing"],
        "complete": ["status:complete", "done"]
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "default": "spec-navigator"
        },
        "repoLabel": {
          "type": "string",
          "default": "debrief-future"
        }
      },
      "default": {
        "title": "spec-navigator",
        "repoLabel": "debrief-future"
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "releaseNotes": {
          "type": "string",
          "format": "uri",
          "default": "https://github.com/debrief/spec-navigator/releases"
        }
      },
      "default": {
        "releaseNotes": "https://github.com/debrief/spec-navigator/releases"
      }
    }
  }
}
