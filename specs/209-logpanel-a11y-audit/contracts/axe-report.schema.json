{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debrief.github.io/debrief-future/schemas/axe-report-v2.schema.json",
  "title": "LogPanel axe-core audit report",
  "description": "Machine-readable output of shared/components/e2e/LogPanel-a11y-axe.spec.ts. Consumed by shared/components/scripts/a11y-audit-report.ts to produce the curated markdown at specs/176-log-panel-ux/evidence/a11y-audit.md.",
  "type": "object",
  "required": [
    "schema",
    "git_sha",
    "captured_at",
    "axe_version",
    "storybook_version",
    "storybook_url",
    "axe_include_selector",
    "axe_tags",
    "coverage",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "axe-report-v2"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "axe_version": {
      "type": "string"
    },
    "storybook_version": {
      "type": "string"
    },
    "storybook_url": {
      "type": "string",
      "format": "uri"
    },
    "axe_include_selector": {
      "type": "string",
      "minLength": 1
    },
    "axe_tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "contains": { "enum": ["wcag2a", "wcag2aa", "wcag21aa"] }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/CoverageEntry" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Finding" }
    }
  },
  "$defs": {
    "Theme": {
      "type": "string",
      "enum": ["light", "dark", "vscode"]
    },
    "Severity": {
      "type": "string",
      "enum": ["minor", "moderate", "serious", "critical"]
    },
    "Classification": {
      "type": "string",
      "enum": ["fix-now", "accepted", "deferred"]
    },
    "CoverageEntry": {
      "type": "object",
      "required": [
        "story_id",
        "story_title",
        "story_name",
        "import_path",
        "theme",
        "status",
        "violations_count",
        "passes_count",
        "incomplete_count"
      ],
      "additionalProperties": false,
      "properties": {
        "story_id": { "type": "string", "minLength": 1 },
        "story_title": { "type": "string", "minLength": 1 },
        "story_name": { "type": "string", "minLength": 1 },
        "import_path": {
          "type": "string",
          "pattern": "^\\./src/LogPanel/"
        },
        "theme": { "$ref": "#/$defs/Theme" },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "error"]
        },
        "violations_count": { "type": "integer", "minimum": 0 },
        "passes_count": { "type": "integer", "minimum": 0 },
        "incomplete_count": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "error" } } },
          "then": { "required": ["error"] }
        }
      ]
    },
    "Finding": {
      "type": "object",
      "required": [
        "rule_id",
        "description",
        "help",
        "help_url",
        "severity",
        "wcag_tags",
        "representative_selector",
        "selector_varies",
        "pairs",
        "classification",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "help": { "type": "string" },
        "help_url": { "type": "string", "format": "uri" },
        "severity": { "$ref": "#/$defs/Severity" },
        "wcag_tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^wcag" },
          "minItems": 1
        },
        "representative_selector": { "type": "string", "minLength": 1 },
        "selector_varies": { "type": "boolean" },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/AffectedPair" }
        },
        "classification": { "$ref": "#/$defs/Classification" },
        "rationale": { "type": "string" },
        "backlog_ref": {
          "type": "string",
          "pattern": "^#[0-9]+$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "deferred" } } },
          "then": { "required": ["backlog_ref"] }
        },
        {
          "if": { "properties": { "classification": { "const": "accepted" } } },
          "then": {
            "properties": {
              "rationale": { "minLength": 1 }
            }
          }
        }
      ]
    },
    "AffectedPair": {
      "type": "object",
      "required": ["story_id", "theme", "selector"],
      "additionalProperties": false,
      "properties": {
        "story_id": { "type": "string", "minLength": 1 },
        "theme": { "$ref": "#/$defs/Theme" },
        "selector": { "type": "string", "minLength": 1 },
        "html_snippet": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
