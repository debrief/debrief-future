{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debrief.info/schemas/storyboard/v1/storyboard.schema.json",
  "title": "Storyboard + Scene (v1) — reference excerpt",
  "description": "Reference JSON Schema excerpt for review during spec stage. The authoritative artefact is generated from shared/schemas/src/linkml/storyboard.yaml at build time; this file is kept in sync as a contract check.",
  "type": "object",
  "definitions": {
    "Ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "IsoInstant": {
      "type": "string",
      "format": "date-time"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "HistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "actor", "op", "summary"],
      "properties": {
        "timestamp": { "$ref": "#/definitions/IsoInstant" },
        "actor": { "type": "string", "minLength": 1 },
        "op": {
          "type": "string",
          "enum": [
            "create", "rename", "describe", "delete", "restore",
            "update-to-current", "duplicate", "copy-in",
            "insert-middle", "refresh-thumbnail"
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 140 }
      }
    },
    "Viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "zoom", "bearing"],
      "properties": {
        "center": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": { "type": "number" },
        "bearing": { "type": "number", "const": 0 }
      }
    },
    "Polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "StoryboardProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "debrief:type", "id", "name", "schema_version",
        "created_by", "created_at", "last_modified_by", "last_modified_at",
        "history"
      ],
      "properties": {
        "debrief:type": { "const": "storyboard" },
        "id": { "$ref": "#/definitions/Ulid" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "created_by": { "type": "string", "minLength": 1 },
        "created_at": { "$ref": "#/definitions/IsoInstant" },
        "last_modified_by": { "type": "string", "minLength": 1 },
        "last_modified_at": { "$ref": "#/definitions/IsoInstant" },
        "history": {
          "type": "array",
          "items": { "$ref": "#/definitions/HistoryEntry" }
        }
      }
    },
    "StoryboardFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "#/definitions/Ulid" },
        "geometry": { "$ref": "#/definitions/Polygon" },
        "properties": { "$ref": "#/definitions/StoryboardProperties" }
      }
    },
    "SceneTimeRange": {
      "type": "null",
      "description": "Reserved in schema v1 — MUST be null."
    },
    "SceneProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "debrief:type", "id", "storyboard_id", "title", "viewport",
        "timestamp", "visible_feature_ids", "feature_set_hash",
        "thumbnail_asset_ref", "transition_duration_ms",
        "created_by", "created_at", "last_modified_by", "last_modified_at",
        "history"
      ],
      "properties": {
        "debrief:type": { "const": "storyboard_scene" },
        "id": { "$ref": "#/definitions/Ulid" },
        "storyboard_id": { "$ref": "#/definitions/Ulid" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "viewport": { "$ref": "#/definitions/Viewport" },
        "timestamp": { "$ref": "#/definitions/IsoInstant" },
        "time_range": { "$ref": "#/definitions/SceneTimeRange" },
        "visible_feature_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "feature_set_hash": { "$ref": "#/definitions/Sha256Hex" },
        "thumbnail_asset_ref": { "type": "string", "minLength": 1 },
        "transition_duration_ms": { "type": "integer", "minimum": 0 },
        "created_by": { "type": "string", "minLength": 1 },
        "created_at": { "$ref": "#/definitions/IsoInstant" },
        "last_modified_by": { "type": "string", "minLength": 1 },
        "last_modified_at": { "$ref": "#/definitions/IsoInstant" },
        "history": {
          "type": "array",
          "items": { "$ref": "#/definitions/HistoryEntry" }
        }
      }
    },
    "SceneFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "#/definitions/Ulid" },
        "geometry": { "$ref": "#/definitions/Polygon" },
        "properties": { "$ref": "#/definitions/SceneProperties" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/StoryboardFeature" },
    { "$ref": "#/definitions/SceneFeature" }
  ]
}
