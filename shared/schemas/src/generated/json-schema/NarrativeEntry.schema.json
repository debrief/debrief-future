{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://debrief.info/schemas/NarrativeEntry",
  "additionalProperties": false,
  "description": "GeoJSON Feature for timestamped narrative/log entries. Narratives are operator notes associated with a timestamp and optionally a track. Geometry is optional (Point for display position, or null).",
  "properties": {
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeoJSONPoint"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional display position (Point) or null"
    },
    "id": {
      "description": "Unique identifier",
      "type": "string"
    },
    "properties": {
      "$ref": "#/$defs/NarrativeEntryProperties",
      "description": "Narrative metadata"
    },
    "type": {
      "const": "Feature",
      "description": "GeoJSON type discriminator",
      "type": "string"
    }
  },
  "required": [
    "type",
    "id",
    "properties"
  ],
  "title": "NarrativeEntry",
  "type": "object",
  "$defs": {
    "CircleAnnotation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for circle annotations. Geometry is a Polygon approximating the circle (vertices at regular intervals). Properties contain center and radius for precise reconstruction and smooth rendering.",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONPolygon",
          "description": "Circle as Polygon (approximated with vertices, e.g., every 45 degrees)"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/CircleAnnotationProperties",
          "description": "Circle metadata including center and radius for reconstruction"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "CircleAnnotation",
      "type": "object"
    },
    "CircleAnnotationProperties": {
      "additionalProperties": false,
      "description": "Properties for a CircleAnnotation",
      "properties": {
        "center": {
          "description": "Circle center as [longitude, latitude] for precise reconstruction",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "color": {
          "description": "Display color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "CIRCLE",
          "description": "Feature type discriminator"
        },
        "label": {
          "description": "Annotation label text",
          "type": [
            "string",
            "null"
          ]
        },
        "radius": {
          "description": "Circle radius in meters for precise reconstruction",
          "minimum": 0,
          "type": "number"
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "center",
        "radius"
      ],
      "title": "CircleAnnotationProperties",
      "type": "object"
    },
    "FeatureKindEnum": {
      "description": "Discriminator for GeoJSON feature types",
      "enum": [
        "TRACK",
        "POINT",
        "NARRATIVE",
        "CIRCLE",
        "RECTANGLE",
        "LINE",
        "TEXT",
        "VECTOR"
      ],
      "title": "FeatureKindEnum",
      "type": "string"
    },
    "GeoJSONLineString": {
      "additionalProperties": false,
      "description": "GeoJSON LineString geometry",
      "properties": {
        "coordinates": {
          "description": "Array of [longitude, latitude] pairs",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "type": {
          "const": "LineString",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONLineString",
      "type": "object"
    },
    "GeoJSONPoint": {
      "additionalProperties": false,
      "description": "GeoJSON Point geometry",
      "properties": {
        "coordinates": {
          "description": "[longitude, latitude] in degrees",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "type": {
          "const": "Point",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONPoint",
      "type": "object"
    },
    "GeoJSONPolygon": {
      "additionalProperties": false,
      "description": "GeoJSON Polygon geometry",
      "properties": {
        "coordinates": {
          "description": "Array of linear rings (arrays of [lon, lat] pairs)",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "type": {
          "const": "Polygon",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONPolygon",
      "type": "object"
    },
    "LineAnnotation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for line segment annotations. Geometry is a LineString with 2 points (start and end).",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONLineString",
          "description": "Line as LineString (2 points)"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/LineAnnotationProperties",
          "description": "Line metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "LineAnnotation",
      "type": "object"
    },
    "LineAnnotationProperties": {
      "additionalProperties": false,
      "description": "Properties for a LineAnnotation",
      "properties": {
        "color": {
          "description": "Display color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "LINE",
          "description": "Feature type discriminator"
        },
        "label": {
          "description": "Annotation label text",
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "title": "LineAnnotationProperties",
      "type": "object"
    },
    "LocationTypeEnum": {
      "description": "Type of reference location",
      "enum": [
        "WAYPOINT",
        "EXERCISE_AREA",
        "DANGER_AREA",
        "ANCHORAGE",
        "PORT",
        "REFERENCE"
      ],
      "title": "LocationTypeEnum",
      "type": "string"
    },
    "NarrativeEntry": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for timestamped narrative/log entries. Narratives are operator notes associated with a timestamp and optionally a track. Geometry is optional (Point for display position, or null).",
      "properties": {
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoJSONPoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional display position (Point) or null"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/NarrativeEntryProperties",
          "description": "Narrative metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "properties"
      ],
      "title": "NarrativeEntry",
      "type": "object"
    },
    "NarrativeEntryProperties": {
      "additionalProperties": false,
      "description": "Properties for a NarrativeEntry annotation",
      "properties": {
        "color": {
          "description": "Display color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "NARRATIVE",
          "description": "Feature type discriminator"
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "Narrative text content",
          "type": "string"
        },
        "time": {
          "description": "Narrative timestamp (ISO8601)",
          "format": "date-time",
          "type": "string"
        },
        "track_id": {
          "description": "Associated track identifier (optional)",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "time",
        "text"
      ],
      "title": "NarrativeEntryProperties",
      "type": "object"
    },
    "RectangleAnnotation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for rectangle annotations. Geometry is a Polygon with 4 corners (plus closing point).",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONPolygon",
          "description": "Rectangle as Polygon (4 corners + close)"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/RectangleAnnotationProperties",
          "description": "Rectangle metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "RectangleAnnotation",
      "type": "object"
    },
    "RectangleAnnotationProperties": {
      "additionalProperties": false,
      "description": "Properties for a RectangleAnnotation",
      "properties": {
        "color": {
          "description": "Display color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "RECTANGLE",
          "description": "Feature type discriminator"
        },
        "label": {
          "description": "Annotation label text",
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "title": "RectangleAnnotationProperties",
      "type": "object"
    },
    "ReferenceLocation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for fixed reference points",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONPoint",
          "description": "Location (Point) or area (Polygon)"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/ReferenceLocationProperties",
          "description": "Reference metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "ReferenceLocation",
      "type": "object"
    },
    "ReferenceLocationProperties": {
      "additionalProperties": false,
      "description": "Properties for a ReferenceLocation",
      "properties": {
        "color": {
          "description": "Display color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Additional description",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "POINT",
          "description": "Feature type discriminator"
        },
        "location_type": {
          "$ref": "#/$defs/LocationTypeEnum",
          "description": "Type of reference"
        },
        "name": {
          "description": "Reference location name",
          "type": "string"
        },
        "symbol": {
          "description": "Map symbol identifier",
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "description": "Start of validity period",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "description": "End of validity period",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "location_type"
      ],
      "title": "ReferenceLocationProperties",
      "type": "object"
    },
    "TextAnnotation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for text annotations at a position. Geometry is the Point where text should be displayed.",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONPoint",
          "description": "Text display position"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/TextAnnotationProperties",
          "description": "Text metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "TextAnnotation",
      "type": "object"
    },
    "TextAnnotationProperties": {
      "additionalProperties": false,
      "description": "Properties for a TextAnnotation",
      "properties": {
        "color": {
          "description": "Display color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "TEXT",
          "description": "Feature type discriminator"
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "Text content to display",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "TextAnnotationProperties",
      "type": "object"
    },
    "TimestampedPosition": {
      "additionalProperties": false,
      "description": "A position with timestamp and optional kinematic data",
      "properties": {
        "coordinates": {
          "description": "[longitude, latitude] in degrees",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "course": {
          "description": "Course in degrees (0-360)",
          "maximum": 360,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "depth": {
          "description": "Depth in meters (negative = below surface)",
          "type": [
            "number",
            "null"
          ]
        },
        "speed": {
          "description": "Speed in knots",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "time": {
          "description": "Position timestamp (ISO8601)",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "time",
        "coordinates"
      ],
      "title": "TimestampedPosition",
      "type": "object"
    },
    "TrackFeature": {
      "additionalProperties": false,
      "description": "GeoJSON Feature representing a vessel track",
      "properties": {
        "bbox": {
          "description": "Bounding box [minLon, minLat, maxLon, maxLat]",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "geometry": {
          "$ref": "#/$defs/GeoJSONLineString",
          "description": "Track path as GeoJSON LineString"
        },
        "id": {
          "description": "Unique identifier (UUID recommended)",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/TrackProperties",
          "description": "Track metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "TrackFeature",
      "type": "object"
    },
    "TrackProperties": {
      "additionalProperties": false,
      "description": "Properties for a TrackFeature",
      "properties": {
        "color": {
          "description": "Display color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "end_time": {
          "description": "Track end time (ISO8601)",
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "TRACK",
          "description": "Feature type discriminator"
        },
        "platform_id": {
          "description": "Platform/vessel identifier",
          "type": "string"
        },
        "platform_name": {
          "description": "Human-readable platform name",
          "type": [
            "string",
            "null"
          ]
        },
        "positions": {
          "description": "Array of timestamped positions",
          "items": {
            "$ref": "#/$defs/TimestampedPosition"
          },
          "minItems": 2,
          "type": "array"
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "start_time": {
          "description": "Track start time (ISO8601)",
          "format": "date-time",
          "type": "string"
        },
        "track_type": {
          "$ref": "#/$defs/TrackTypeEnum",
          "description": "Type of track"
        }
      },
      "required": [
        "kind",
        "platform_id",
        "track_type",
        "start_time",
        "end_time",
        "positions"
      ],
      "title": "TrackProperties",
      "type": "object"
    },
    "TrackTypeEnum": {
      "description": "Type of track feature",
      "enum": [
        "OWNSHIP",
        "CONTACT",
        "REFERENCE",
        "SOLUTION"
      ],
      "title": "TrackTypeEnum",
      "type": "string"
    },
    "VectorAnnotation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for vector annotations. Geometry is a LineString from origin to endpoint (computed from range/bearing). Properties contain origin, range, and bearing for precise reconstruction.",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONLineString",
          "description": "Vector as LineString (origin to computed endpoint)"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/VectorAnnotationProperties",
          "description": "Vector metadata including origin, range, and bearing for reconstruction"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "VectorAnnotation",
      "type": "object"
    },
    "VectorAnnotationProperties": {
      "additionalProperties": false,
      "description": "Properties for a VectorAnnotation",
      "properties": {
        "bearing": {
          "description": "Vector bearing in degrees (0-360, from north) for precise reconstruction",
          "maximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "color": {
          "description": "Display color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "VECTOR",
          "description": "Feature type discriminator"
        },
        "label": {
          "description": "Annotation label text",
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "description": "Vector origin as [longitude, latitude] for precise reconstruction",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "range": {
          "description": "Vector length/range in meters for precise reconstruction",
          "minimum": 0,
          "type": "number"
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "origin",
        "range",
        "bearing"
      ],
      "title": "VectorAnnotationProperties",
      "type": "object"
    }
  }
}