{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://debrief.info/schemas/TrackFeature",
  "additionalProperties": false,
  "description": "GeoJSON Feature representing a vessel track",
  "properties": {
    "bbox": {
      "description": "Bounding box [minLon, minLat, maxLon, maxLat]",
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": [
        "array",
        "null"
      ]
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeoJSONLineString"
        },
        {
          "$ref": "#/$defs/GeoJSONMultiLineString"
        }
      ],
      "description": "Track path as LineString (simple) or MultiLineString (compound)"
    },
    "id": {
      "description": "Unique identifier (UUID recommended)",
      "type": "string"
    },
    "properties": {
      "$ref": "#/$defs/TrackProperties",
      "description": "Track metadata"
    },
    "type": {
      "const": "Feature",
      "description": "GeoJSON type discriminator",
      "type": "string"
    }
  },
  "required": [
    "type",
    "id",
    "geometry",
    "properties"
  ],
  "title": "TrackFeature",
  "type": "object",
  "$defs": {
    "ActivityType": {
      "description": "Semantic discriminator for provenance records. Consumers use this field to choose rendering or handling behaviour independently of visual tool-category grouping. Introduced by feature 208 so future entry types (manual checkpoint, standalone tune, manual rationale) can be distinguished without overloading tool-category.",
      "enum": [
        "snapshot",
        "tool",
        "tune"
      ],
      "title": "ActivityType",
      "type": "string"
    },
    "ArrayCentreModeEnum": {
      "description": "Array centre calculation mode for towed array sensors",
      "enum": [
        "PLAIN",
        "WORM",
        "MEASURED"
      ],
      "title": "ArrayCentreModeEnum",
      "type": "string"
    },
    "FeatureKindEnum": {
      "description": "Discriminator for GeoJSON feature types",
      "enum": [
        "TRACK",
        "POINT",
        "NARRATIVE",
        "CIRCLE",
        "RECTANGLE",
        "LINE",
        "TEXT",
        "VECTOR",
        "SYSTEM",
        "POLY",
        "MULTI_POINT",
        "MULTI_POLYGON",
        "SYSTEM_RECORD",
        "STORYBOARD",
        "STORYBOARD_SCENE"
      ],
      "title": "FeatureKindEnum",
      "type": "string"
    },
    "GeoJSONLineString": {
      "additionalProperties": false,
      "description": "GeoJSON LineString geometry",
      "properties": {
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2
          },
          "description": "Array of [longitude, latitude] pairs"
        },
        "type": {
          "const": "LineString",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONLineString",
      "type": "object"
    },
    "GeoJSONMultiLineString": {
      "additionalProperties": false,
      "description": "GeoJSON MultiLineString geometry for compound tracks",
      "properties": {
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2
            }
          },
          "description": "Array of LineString coordinate arrays"
        },
        "type": {
          "const": "MultiLineString",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONMultiLineString",
      "type": "object"
    },
    "InputFeatureState": {
      "additionalProperties": false,
      "description": "Pre-operation state of a feature captured before a coordinate-mutating tool executes. Enables correct replay by providing the original geometry as the anchor for re-computation with modified parameters.",
      "properties": {
        "feature_id": {
          "description": "ID of the feature whose pre-operation state is captured.",
          "type": "string"
        },
        "geometry": {
          "description": "Full GeoJSON geometry object (type + coordinates) as it was immediately before the operation. Stored as a JSON object.",
          "type": "string"
        },
        "properties": {
          "description": "Kind-specific spatial properties captured before the operation. Excludes provenance (which is append-only). Null if no spatial properties need capturing.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "feature_id",
        "geometry"
      ],
      "title": "InputFeatureState",
      "type": "object"
    },
    "LabelLocationEnum": {
      "description": "Horizontal alignment of contact labels",
      "enum": [
        "LEFT",
        "CENTER",
        "RIGHT"
      ],
      "title": "LabelLocationEnum",
      "type": "string"
    },
    "LineCapEnum": {
      "description": "How line endpoints are rendered (SVG/CSS standard)",
      "enum": [
        "butt",
        "round",
        "square"
      ],
      "title": "LineCapEnum",
      "type": "string"
    },
    "LineJoinEnum": {
      "description": "How line segment joints are rendered (SVG/CSS standard)",
      "enum": [
        "miter",
        "round",
        "bevel"
      ],
      "title": "LineJoinEnum",
      "type": "string"
    },
    "LineLabelPositionEnum": {
      "description": "Position along the bearing line where the label is placed",
      "enum": [
        "START",
        "MIDDLE",
        "END"
      ],
      "title": "LineLabelPositionEnum",
      "type": "string"
    },
    "LineProperties": {
      "additionalProperties": false,
      "description": "Styling schema for LineString and MultiLineString geometries. Follows Leaflet Polyline options naming conventions.",
      "properties": {
        "color": {
          "description": "Line color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "dash_array": {
          "description": "Dash pattern (SVG format, e.g., \"5, 10\")",
          "type": [
            "string",
            "null"
          ]
        },
        "line_cap": {
          "$ref": "#/$defs/LineCapEnum",
          "description": "Line endpoint style"
        },
        "line_join": {
          "$ref": "#/$defs/LineJoinEnum",
          "description": "Line join style"
        },
        "opacity": {
          "description": "Line transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "stroke": {
          "description": "Whether to draw the line",
          "type": [
            "boolean",
            "null"
          ]
        },
        "weight": {
          "description": "Line width in pixels",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "color"
      ],
      "title": "LineProperties",
      "type": "object"
    },
    "LineStyleEnum": {
      "description": "Visual style for bearing lines",
      "enum": [
        "SOLID",
        "DASHED",
        "DOT",
        "DASH_DOT"
      ],
      "title": "LineStyleEnum",
      "type": "string"
    },
    "LogEntry": {
      "additionalProperties": false,
      "description": "A PROV-aligned provenance record stored on GeoJSON features. Contains activity identity, timestamp, generator information, input/output references, execution duration, and tuning annotations.",
      "properties": {
        "activity_id": {
          "description": "Unique operation identifier (UUID v4). Shared across features in multi-feature operations.",
          "type": "string"
        },
        "activity_type": {
          "$ref": "#/$defs/ActivityType",
          "description": "Semantic kind of this provenance record. Optional; absent records are treated as `tool` by consumers. Introduced by feature 208 so future entry types (manual checkpoint, standalone tune, manual rationale) can be distinguished without overloading visual tool-category. See `shared/components/src/LogPanel/types.ts` `TimelineEntryKind` for the UI-side mirror."
        },
        "agent": {
          "description": "Human actor (e.g. analyst username) who triggered the operation. Added by #215 for Storyboarding CRUD provenance; optional and useful to any tool emitting LogEntry records.",
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "description": "Whether this entry is skipped during replay. Toggled via the flip-card edit face.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "execution_duration": {
          "description": "Wall-clock execution time in ISO 8601 duration format (e.g., PT0.3S).",
          "pattern": "^PT[0-9]+(\\.[0-9]+)?S$",
          "type": "string"
        },
        "generated": {
          "description": "Feature IDs or versioned asset paths of outputs. May be empty for in-place modifications.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "generated_result_id": {
          "description": "Stable logical identity for artifact-producing tools. Null for non-artifact tools.",
          "type": [
            "string",
            "null"
          ]
        },
        "input_state": {
          "description": "Pre-operation feature states for coordinate-mutating tools. Captures geometry and spatial properties as they were immediately before the operation, enabling correct replay with modified parameters. Null for non-mutation tools.",
          "items": {
            "$ref": "#/$defs/InputFeatureState"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "rationale": {
          "description": "Free-text analyst annotation explaining the reasoning for this operation.",
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "description": "When the operation occurred (ISO 8601 with timezone).",
          "format": "date-time",
          "type": "string"
        },
        "tune": {
          "anyOf": [
            {
              "$ref": "#/$defs/TuneAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parameter tuning record. Null until a tuning operation modifies this entry."
        },
        "used": {
          "description": "Feature IDs of inputs. May be empty for operations with no explicit inputs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "was_generated_by": {
          "$ref": "#/$defs/WasGeneratedBy",
          "description": "Tool identity and parameters for this invocation."
        }
      },
      "required": [
        "activity_id",
        "timestamp",
        "was_generated_by",
        "used",
        "generated",
        "execution_duration"
      ],
      "title": "LogEntry",
      "type": "object"
    },
    "MeasuredArrayPosition": {
      "additionalProperties": false,
      "description": "Timestamped geographic position of a towed array centre. Used by MEASURED array centre mode for bearing line origin interpolation.",
      "properties": {
        "location": {
          "description": "Array centre position [longitude, latitude] (GeoJSON coordinate order)",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "time": {
          "description": "Position timestamp (ISO8601)",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "time",
        "location"
      ],
      "title": "MeasuredArrayPosition",
      "type": "object"
    },
    "ParameterValue": {
      "additionalProperties": false,
      "description": "A typed parameter value with replay metadata.",
      "properties": {
        "default": {
          "description": "Whether this is the default value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "tunable": {
          "description": "Whether this parameter can be modified during replay.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "value": {
          "description": "The parameter value (any JSON type).",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ParameterValue",
      "type": "object"
    },
    "PointProperties": {
      "additionalProperties": false,
      "description": "Styling schema for Point and MultiPoint geometries. Follows Leaflet CircleMarker options naming conventions.",
      "properties": {
        "color": {
          "description": "Stroke color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "fill": {
          "description": "Whether to fill the shape",
          "type": [
            "boolean",
            "null"
          ]
        },
        "fill_color": {
          "description": "Fill color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "fill_opacity": {
          "description": "Fill transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "legacy_style": {
          "description": "Legacy symbol name from Debrief symbology (e.g., 'Aircraft', 'torpedo'). Preserved for future icon rendering support.",
          "type": [
            "string",
            "null"
          ]
        },
        "opacity": {
          "description": "Stroke transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "radius": {
          "description": "Marker radius in pixels",
          "minimum": 0,
          "type": "number"
        },
        "shape": {
          "$ref": "#/$defs/PointShapeEnum",
          "description": "Marker shape"
        },
        "stroke": {
          "description": "Whether to draw outline",
          "type": [
            "boolean",
            "null"
          ]
        },
        "weight": {
          "description": "Stroke width in pixels",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "shape",
        "radius",
        "fill_color",
        "color"
      ],
      "title": "PointProperties",
      "type": "object"
    },
    "PointShapeEnum": {
      "description": "Valid shapes for point markers",
      "enum": [
        "circle",
        "square",
        "triangle",
        "diamond",
        "cross"
      ],
      "title": "PointShapeEnum",
      "type": "string"
    },
    "PositionStyle": {
      "additionalProperties": false,
      "description": "Default styling configuration for track positions. Applied as baseline before interval rules and overrides.",
      "properties": {
        "show_label": {
          "description": "Whether to display labels at positions",
          "type": "boolean"
        },
        "show_symbol": {
          "description": "Whether to display a symbol at positions",
          "type": "boolean"
        },
        "symbol": {
          "$ref": "#/$defs/PointShapeEnum",
          "description": "Shape to use for position symbols"
        }
      },
      "required": [
        "show_symbol",
        "symbol",
        "show_label"
      ],
      "title": "PositionStyle",
      "type": "object"
    },
    "PositionStyleOverride": {
      "additionalProperties": false,
      "description": "Per-position style override. Index in array determines which position. No time field - array index i applies to positions[i]. Use null for positions without custom styling.",
      "properties": {
        "label": {
          "description": "Custom label text (null = use timestamp)",
          "type": [
            "string",
            "null"
          ]
        },
        "show_label": {
          "description": "Override whether to show label",
          "type": [
            "boolean",
            "null"
          ]
        },
        "show_symbol": {
          "description": "Override whether to show symbol (null = use default/interval)",
          "type": [
            "boolean",
            "null"
          ]
        },
        "symbol": {
          "$ref": "#/$defs/PointShapeEnum",
          "description": "Override symbol shape"
        }
      },
      "title": "PositionStyleOverride",
      "type": "object"
    },
    "SegmentMetadata": {
      "additionalProperties": false,
      "description": "Per-segment metadata for compound tracks. Each segment corresponds to one LineString within a MultiLineString geometry. segments[i] describes geometry.coordinates[i].",
      "properties": {
        "after_leg": {
          "description": "Name of following TMA leg (DYNAMIC_INFILL)",
          "type": [
            "string",
            "null"
          ]
        },
        "base_frequency": {
          "description": "Base frequency in Hz (TMA segments)",
          "type": [
            "number",
            "null"
          ]
        },
        "before_leg": {
          "description": "Name of preceding TMA leg (DYNAMIC_INFILL)",
          "type": [
            "string",
            "null"
          ]
        },
        "course": {
          "description": "Estimated course in degrees (TMA segments)",
          "maximum": 360,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "end_time": {
          "description": "Segment end timestamp (ISO8601)",
          "format": "date-time",
          "type": "string"
        },
        "host_sensor_name": {
          "description": "Towed array sensor name (RELATIVE_TMA)",
          "type": [
            "string",
            "null"
          ]
        },
        "host_track_id": {
          "description": "ID of track this solution is relative to (RELATIVE_TMA)",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Human-readable segment name",
          "type": [
            "string",
            "null"
          ]
        },
        "offset_bearing": {
          "description": "Bearing offset in degrees (RELATIVE_TMA)",
          "maximum": 360,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "offset_range": {
          "description": "Range offset in metres (RELATIVE_TMA)",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "positions": {
          "description": "Per-position metadata (parallel to coordinates)",
          "items": {
            "$ref": "#/$defs/TimestampedPosition"
          },
          "type": "array"
        },
        "segment_type": {
          "$ref": "#/$defs/SegmentTypeEnum",
          "description": "Segment type discriminator"
        },
        "speed": {
          "description": "Estimated speed in knots (TMA segments)",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "start_time": {
          "description": "Segment start timestamp (ISO8601)",
          "format": "date-time",
          "type": "string"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineProperties"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-segment line styling override"
        }
      },
      "required": [
        "segment_type",
        "start_time",
        "end_time",
        "positions"
      ],
      "title": "SegmentMetadata",
      "type": "object"
    },
    "SegmentTypeEnum": {
      "description": "Discriminator for track segment types within compound tracks",
      "enum": [
        "TRACK",
        "ABSOLUTE_TMA",
        "RELATIVE_TMA",
        "DYNAMIC_INFILL"
      ],
      "title": "SegmentTypeEnum",
      "type": "string"
    },
    "SensorContact": {
      "additionalProperties": false,
      "description": "Single sensor measurement record. Represents one bearing/range observation at a point in time.",
      "properties": {
        "ambiguous_bearing": {
          "description": "Ambiguous bearing (second solution) in degrees",
          "maximum": 360,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "bearing": {
          "description": "Bearing to contact in degrees (0-360)",
          "maximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "color": {
          "description": "Contact color override (null = inherit from parent SensorData)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "comment": {
          "description": "Operator note",
          "type": [
            "string",
            "null"
          ]
        },
        "frequency": {
          "description": "Measured frequency in Hz",
          "type": [
            "number",
            "null"
          ]
        },
        "has_ambiguous": {
          "description": "Controls ambiguous bearing display",
          "type": [
            "boolean",
            "null"
          ]
        },
        "has_bearing": {
          "description": "Controls bearing line display (true=show, false=hide). Data stored regardless.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "has_frequency": {
          "description": "Controls frequency data display",
          "type": [
            "boolean",
            "null"
          ]
        },
        "label": {
          "description": "Display label",
          "type": [
            "string",
            "null"
          ]
        },
        "label_location": {
          "$ref": "#/$defs/LabelLocationEnum",
          "description": "Label horizontal alignment"
        },
        "line_style": {
          "$ref": "#/$defs/LineStyleEnum",
          "description": "Bearing line visual style"
        },
        "origin": {
          "description": "Explicit sensor location override [longitude, latitude]",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "put_label_at": {
          "$ref": "#/$defs/LineLabelPositionEnum",
          "description": "Label position along bearing line"
        },
        "range": {
          "description": "Range to contact in metres",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "show_label": {
          "description": "Label visibility",
          "type": [
            "boolean",
            "null"
          ]
        },
        "time": {
          "description": "Contact measurement timestamp (ISO8601)",
          "format": "date-time",
          "type": "string"
        },
        "visible": {
          "description": "Contact visibility",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "time",
        "bearing"
      ],
      "title": "SensorContact",
      "type": "object"
    },
    "SensorData": {
      "additionalProperties": false,
      "description": "Named sensor with contact measurements. Embedded in TrackProperties to associate sensor data with the host track.",
      "properties": {
        "array_centre_mode": {
          "$ref": "#/$defs/ArrayCentreModeEnum",
          "description": "How bearing line origin is calculated relative to host platform"
        },
        "base_frequency": {
          "description": "Reference frequency in Hz",
          "type": [
            "number",
            "null"
          ]
        },
        "color": {
          "description": "Default color for all contacts in this sensor",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": [
            "string",
            "null"
          ]
        },
        "contacts": {
          "description": "Array of sensor measurements",
          "items": {
            "$ref": "#/$defs/SensorContact"
          },
          "type": "array"
        },
        "line_thickness": {
          "description": "Bearing line width in pixels",
          "type": [
            "integer",
            "null"
          ]
        },
        "measured_positions": {
          "description": "Actual towed array positions for MEASURED array centre mode",
          "items": {
            "$ref": "#/$defs/MeasuredArrayPosition"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "name": {
          "description": "Sensor identifier (e.g., \"TOWED_ARRAY\")",
          "type": "string"
        },
        "offset": {
          "description": "Sensor offset from host platform in metres",
          "type": [
            "number",
            "null"
          ]
        },
        "visible": {
          "description": "Sensor visibility",
          "type": [
            "boolean",
            "null"
          ]
        },
        "worm_in_hole": {
          "description": "Display mode flag",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "contacts"
      ],
      "title": "SensorData",
      "type": "object"
    },
    "TUAData": {
      "additionalProperties": false,
      "description": "Named TUA solution collection. Embedded in TrackProperties to associate TUA data with the host track.",
      "properties": {
        "host_track_name": {
          "description": "Name of track this TUA set relates to",
          "type": "string"
        },
        "name": {
          "description": "TUA collection name",
          "type": "string"
        },
        "solutions": {
          "description": "Array of TUA estimates",
          "items": {
            "$ref": "#/$defs/TUASolution"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "host_track_name",
        "solutions"
      ],
      "title": "TUAData",
      "type": "object"
    },
    "TUASolution": {
      "additionalProperties": false,
      "description": "Single Target Uncertainty Area estimate. Has either absolute positioning (centre_lat/centre_lon) or relative positioning (bearing/range), plus optional ellipse and kinematics.",
      "properties": {
        "bearing": {
          "description": "Relative bearing from host track in degrees",
          "maximum": 360,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "centre_lat": {
          "description": "Absolute latitude (mutual exclusive with bearing/range)",
          "type": [
            "number",
            "null"
          ]
        },
        "centre_lon": {
          "description": "Absolute longitude (mutual exclusive with bearing/range)",
          "type": [
            "number",
            "null"
          ]
        },
        "course": {
          "description": "Estimated course in degrees",
          "maximum": 360,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "depth": {
          "description": "Estimated depth in metres",
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "description": "Solution label",
          "type": "string"
        },
        "maxima": {
          "description": "Semi-major axis in metres",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "minima": {
          "description": "Semi-minor axis in metres",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "orientation": {
          "description": "Ellipse orientation from north in degrees",
          "maximum": 360,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "range": {
          "description": "Relative range from host track in metres",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "speed": {
          "description": "Estimated speed in knots",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "time": {
          "description": "Solution timestamp (ISO8601)",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "time",
        "label"
      ],
      "title": "TUASolution",
      "type": "object"
    },
    "TimestampedPosition": {
      "additionalProperties": false,
      "description": "Temporal and kinematic metadata for a single track position. Coordinates are NOT stored here - they live in geometry.coordinates[i]. Position metadata at index i corresponds to coordinate at index i.",
      "properties": {
        "course": {
          "description": "Course in degrees (0-360)",
          "maximum": 360,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "depth": {
          "description": "Depth in meters (negative = below surface)",
          "type": [
            "number",
            "null"
          ]
        },
        "speed": {
          "description": "Speed in knots",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "time": {
          "description": "Position timestamp (ISO8601)",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "time"
      ],
      "title": "TimestampedPosition",
      "type": "object"
    },
    "TrackProperties": {
      "additionalProperties": false,
      "description": "Properties for a TrackFeature",
      "properties": {
        "default_position_style": {
          "$ref": "#/$defs/PositionStyle",
          "description": "Default styling applied to all positions"
        },
        "display_name": {
          "description": "Human-readable platform display name override. When set, overrides the registry-derived name for this track.",
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "$ref": "#/$defs/VesselDomainEnum",
          "description": "Vessel domain override. When set, overrides the registry-derived domain."
        },
        "end_time": {
          "description": "Track end time (ISO8601)",
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "TRACK",
          "description": "Feature type discriminator"
        },
        "label_interval": {
          "description": "ISO 8601 duration for interval-based label display. Null means no interval-based labels.",
          "pattern": "^P(T[0-9]+[HMS])+$|^P[0-9]+D(T[0-9]+[HMS]+)?$",
          "type": [
            "string",
            "null"
          ]
        },
        "nationality": {
          "description": "ISO 3166-1 alpha-2 country code override (e.g., GB, US). When set, overrides the registry-derived nationality.",
          "pattern": "^[A-Z]{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "platform_id": {
          "description": "Platform/vessel identifier",
          "type": "string"
        },
        "platform_name": {
          "description": "Human-readable platform name",
          "type": [
            "string",
            "null"
          ]
        },
        "position_style_overrides": {
          "description": "Parallel array of per-position style overrides. Same length as positions array. Use null entries for positions without custom styling.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/PositionStyleOverride"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": [
            "array",
            "null"
          ]
        },
        "positions": {
          "description": "Array of timestamped positions",
          "items": {
            "$ref": "#/$defs/TimestampedPosition"
          },
          "minItems": 2,
          "type": "array"
        },
        "provenance": {
          "description": "PROV-aligned provenance records (append-only log of tool operations)",
          "items": {
            "$ref": "#/$defs/LogEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "segments": {
          "description": "Per-segment metadata for compound tracks. When present, geometry MUST be MultiLineString and segments[i] describes coordinates[i]. When absent, geometry is LineString and the flat positions array is used.",
          "items": {
            "$ref": "#/$defs/SegmentMetadata"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "sensors": {
          "description": "Embedded sensor data associated with this track. Each sensor contains named metadata and an array of contact measurements.",
          "items": {
            "$ref": "#/$defs/SensorData"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "start_time": {
          "description": "Track start time (ISO8601)",
          "format": "date-time",
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/TrackStyle",
          "description": "Composite styling for track line and position markers"
        },
        "symbol_interval": {
          "description": "ISO 8601 duration for interval-based symbol display. E.g., \"PT5M\" = every 5 minutes, \"PT1H\" = every hour. Null means no interval-based symbols.",
          "pattern": "^P(T[0-9]+[HMS])+$|^P[0-9]+D(T[0-9]+[HMS]+)?$",
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "description": "Free-text labels assigned to this feature by the analyst",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "track_type": {
          "$ref": "#/$defs/TrackTypeEnum",
          "description": "Type of track"
        },
        "tuas": {
          "description": "Embedded Target Uncertainty Area data associated with this track. Each TUA entry is a named collection of time-indexed solutions.",
          "items": {
            "$ref": "#/$defs/TUAData"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "vertex_metadata": {
          "description": "Sparse list of per-vertex metadata, keyed by `path`. Empty arrays MUST be omitted from the serialised feature (FR-010). Duplicate `path` values MUST be rejected by validators (contract \u00a7Cross-cutting #3). Every concrete subclass of `BaseFeatureProperties` gains this slot by inheritance \u2014 see spec #192, contracts/vertex-metadata-slot.md.",
          "items": {
            "$ref": "#/$defs/VertexMetadata"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "vessel_class": {
          "description": "Full vessel classification path override using slash-separated notation (e.g., surface/warship/frigate/type23). When set, overrides registry-derived path.",
          "pattern": "^[a-z0-9-]+(/[a-z0-9-]+){0,3}$",
          "type": [
            "string",
            "null"
          ]
        },
        "vessel_role": {
          "description": "Vessel role override (parent of leaf in classification path, e.g., frigate). When set, overrides the registry-derived role.",
          "pattern": "^[a-z0-9-]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "vessel_type": {
          "description": "Vessel type override (leaf of classification path, e.g., type23). When set, overrides the registry-derived type.",
          "pattern": "^[a-z0-9-]+$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "platform_id",
        "track_type",
        "start_time",
        "end_time",
        "positions",
        "style",
        "default_position_style"
      ],
      "title": "TrackProperties",
      "type": "object"
    },
    "TrackStyle": {
      "additionalProperties": false,
      "description": "Composite styling for TrackFeature, supporting both line path and position markers.",
      "properties": {
        "line": {
          "$ref": "#/$defs/LineProperties",
          "description": "Styling for the track line path"
        },
        "point": {
          "$ref": "#/$defs/PointProperties",
          "description": "Styling for position markers"
        }
      },
      "required": [
        "line",
        "point"
      ],
      "title": "TrackStyle",
      "type": "object"
    },
    "TrackTypeEnum": {
      "description": "Type of track feature",
      "enum": [
        "OWNSHIP",
        "CONTACT",
        "REFERENCE",
        "SOLUTION"
      ],
      "title": "TrackTypeEnum",
      "type": "string"
    },
    "TuneAnnotation": {
      "additionalProperties": false,
      "description": "Records a parameter modification (appended, not replacing original).",
      "properties": {
        "new_value": {
          "description": "Value after tuning.",
          "type": "string"
        },
        "parameter": {
          "description": "Name of the parameter that was changed.",
          "type": "string"
        },
        "previous_value": {
          "description": "Value before tuning.",
          "type": "string"
        },
        "timestamp": {
          "description": "When the tuning occurred (ISO 8601 with timezone).",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "parameter",
        "previous_value",
        "new_value"
      ],
      "title": "TuneAnnotation",
      "type": "object"
    },
    "VertexMetadata": {
      "additionalProperties": false,
      "description": "Optional, sparse per-vertex annotation attached to a feature. One entry corresponds to one vertex of the parent feature's geometry, identified by the structured `path` slot following the `selectionPath` convention (research note R-008). Carrying any of label/tags/note triggers persistence; an entry with all three absent MUST be omitted on write (the writer's flush function prunes). Path shape depends on parent geometry:\n  Track       -> \"positions/<int>\"\n  Polygon     -> \"rings/<int>/vertices/<int>\"\n  LineString  -> \"vertices/<int>\"\n  MultiPoint  -> \"vertices/<int>\"\n  Point       -> \"vertex/0\"",
      "properties": {
        "label": {
          "description": "Free-text short label.",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "description": "Free-text long note.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Structured vertex address following the selectionPath convention. The class-level regex accepts the union of all per-geometry path shapes; the writer additionally checks that the path matches the parent geometry's specific shape at flush time. Acts as the identity for an entry within a feature's `vertex_metadata` list \u2014 duplicates MUST be rejected by validators.",
          "pattern": "^(positions/[0-9]+|rings/[0-9]+/vertices/[0-9]+|vertices/[0-9]+|vertex/0)$",
          "type": "string"
        },
        "tags": {
          "description": "Free-text tag list. Order is not significant.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "title": "VertexMetadata",
      "type": "object"
    },
    "VesselDomainEnum": {
      "description": "Top-level vessel domain classification",
      "enum": [
        "surface",
        "subsurface",
        "unknown"
      ],
      "title": "VesselDomainEnum",
      "type": "string"
    },
    "WasGeneratedBy": {
      "additionalProperties": false,
      "description": "Identifies the tool and its parameters for a specific invocation. Named after the W3C PROV vocabulary term.",
      "properties": {
        "parameters": {
          "description": "Full resolved parameter set. Keys are parameter names, values are ParameterValue objects. May be empty dict.",
          "items": {
            "$ref": "#/$defs/ParameterValue"
          },
          "type": "array"
        },
        "tool": {
          "description": "Tool identifier (kebab-case, e.g., calculate-range).",
          "type": "string"
        },
        "tool_version": {
          "description": "Semantic version of the tool (e.g., 1.2.0).",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "parameters"
      ],
      "title": "WasGeneratedBy",
      "type": "object"
    }
  }
}