{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://debrief.info/schemas/ReferenceLocation",
  "additionalProperties": false,
  "description": "GeoJSON Feature for fixed reference points or reference point sets",
  "properties": {
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeoJSONPoint"
        },
        {
          "$ref": "#/$defs/GeoJSONMultiPoint"
        }
      ],
      "description": "Location (Point) or reference point set (MultiPoint)"
    },
    "id": {
      "description": "Unique identifier",
      "type": "string"
    },
    "properties": {
      "$ref": "#/$defs/ReferenceLocationProperties",
      "description": "Reference metadata"
    },
    "type": {
      "const": "Feature",
      "description": "GeoJSON type discriminator",
      "type": "string"
    }
  },
  "required": [
    "type",
    "id",
    "geometry",
    "properties"
  ],
  "title": "ReferenceLocation",
  "type": "object",
  "$defs": {
    "FeatureKindEnum": {
      "description": "Discriminator for GeoJSON feature types",
      "enum": [
        "TRACK",
        "POINT",
        "NARRATIVE",
        "CIRCLE",
        "RECTANGLE",
        "LINE",
        "TEXT",
        "VECTOR",
        "SYSTEM",
        "POLY",
        "MULTI_POINT",
        "MULTI_POLYGON",
        "SYSTEM_RECORD"
      ],
      "title": "FeatureKindEnum",
      "type": "string"
    },
    "GeoJSONMultiPoint": {
      "additionalProperties": false,
      "description": "GeoJSON MultiPoint geometry for reference point sets",
      "properties": {
        "coordinates": {
          "description": "Array of [longitude, latitude] pairs",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "type": {
          "const": "MultiPoint",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONMultiPoint",
      "type": "object"
    },
    "GeoJSONPoint": {
      "additionalProperties": false,
      "description": "GeoJSON Point geometry",
      "properties": {
        "coordinates": {
          "description": "[longitude, latitude] in degrees",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "type": {
          "const": "Point",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONPoint",
      "type": "object"
    },
    "InputFeatureState": {
      "additionalProperties": false,
      "description": "Pre-operation state of a feature captured before a coordinate-mutating tool executes. Enables correct replay by providing the original geometry as the anchor for re-computation with modified parameters.",
      "properties": {
        "feature_id": {
          "description": "ID of the feature whose pre-operation state is captured.",
          "type": "string"
        },
        "geometry": {
          "description": "Full GeoJSON geometry object (type + coordinates) as it was immediately before the operation. Stored as a JSON object.",
          "type": "string"
        },
        "properties": {
          "description": "Kind-specific spatial properties captured before the operation. Excludes provenance (which is append-only). Null if no spatial properties need capturing.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "feature_id",
        "geometry"
      ],
      "title": "InputFeatureState",
      "type": "object"
    },
    "LocationTypeEnum": {
      "description": "Type of reference location",
      "enum": [
        "WAYPOINT",
        "EXERCISE_AREA",
        "DANGER_AREA",
        "ANCHORAGE",
        "PORT",
        "REFERENCE"
      ],
      "title": "LocationTypeEnum",
      "type": "string"
    },
    "LogEntry": {
      "additionalProperties": false,
      "description": "A PROV-aligned provenance record stored on GeoJSON features. Contains activity identity, timestamp, generator information, input/output references, execution duration, and tuning annotations.",
      "properties": {
        "activity_id": {
          "description": "Unique operation identifier (UUID v4). Shared across features in multi-feature operations.",
          "type": "string"
        },
        "disabled": {
          "description": "Whether this entry is skipped during replay. Toggled via the flip-card edit face.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "execution_duration": {
          "description": "Wall-clock execution time in ISO 8601 duration format (e.g., PT0.3S).",
          "pattern": "^PT[0-9]+(\\.[0-9]+)?S$",
          "type": "string"
        },
        "generated": {
          "description": "Feature IDs or versioned asset paths of outputs. May be empty for in-place modifications.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "generated_result_id": {
          "description": "Stable logical identity for artifact-producing tools. Null for non-artifact tools.",
          "type": [
            "string",
            "null"
          ]
        },
        "input_state": {
          "description": "Pre-operation feature states for coordinate-mutating tools. Captures geometry and spatial properties as they were immediately before the operation, enabling correct replay with modified parameters. Null for non-mutation tools.",
          "items": {
            "$ref": "#/$defs/InputFeatureState"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "rationale": {
          "description": "Free-text analyst annotation explaining the reasoning for this operation.",
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "description": "When the operation occurred (ISO 8601 with timezone).",
          "format": "date-time",
          "type": "string"
        },
        "tune": {
          "anyOf": [
            {
              "$ref": "#/$defs/TuneAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parameter tuning record. Null until a tuning operation modifies this entry."
        },
        "used": {
          "description": "Feature IDs of inputs. May be empty for operations with no explicit inputs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "was_generated_by": {
          "$ref": "#/$defs/WasGeneratedBy",
          "description": "Tool identity and parameters for this invocation."
        }
      },
      "required": [
        "activity_id",
        "timestamp",
        "was_generated_by",
        "used",
        "generated",
        "execution_duration"
      ],
      "title": "LogEntry",
      "type": "object"
    },
    "ParameterValue": {
      "additionalProperties": false,
      "description": "A typed parameter value with replay metadata.",
      "properties": {
        "default": {
          "description": "Whether this is the default value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "tunable": {
          "description": "Whether this parameter can be modified during replay.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "value": {
          "description": "The parameter value (any JSON type).",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ParameterValue",
      "type": "object"
    },
    "PointMetadataEntry": {
      "additionalProperties": false,
      "description": "Metadata for a single point within a MultiPoint reference set. Entries are parallel to the MultiPoint coordinates array. Downstream tools (#081 classifier) extend entries with zone/color fields.",
      "properties": {
        "index": {
          "description": "0-based ordinal matching coordinates array position",
          "type": "integer"
        },
        "name": {
          "description": "Human-readable point label (e.g., \"Ref 1\")",
          "type": "string"
        }
      },
      "required": [
        "index",
        "name"
      ],
      "title": "PointMetadataEntry",
      "type": "object"
    },
    "PointProperties": {
      "additionalProperties": false,
      "description": "Styling schema for Point and MultiPoint geometries. Follows Leaflet CircleMarker options naming conventions.",
      "properties": {
        "color": {
          "description": "Stroke color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "fill": {
          "description": "Whether to fill the shape",
          "type": [
            "boolean",
            "null"
          ]
        },
        "fill_color": {
          "description": "Fill color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "fill_opacity": {
          "description": "Fill transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "legacy_style": {
          "description": "Legacy symbol name from Debrief symbology (e.g., 'Aircraft', 'torpedo'). Preserved for future icon rendering support.",
          "type": [
            "string",
            "null"
          ]
        },
        "opacity": {
          "description": "Stroke transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "radius": {
          "description": "Marker radius in pixels",
          "minimum": 0,
          "type": "number"
        },
        "shape": {
          "$ref": "#/$defs/PointShapeEnum",
          "description": "Marker shape"
        },
        "stroke": {
          "description": "Whether to draw outline",
          "type": [
            "boolean",
            "null"
          ]
        },
        "weight": {
          "description": "Stroke width in pixels",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "shape",
        "radius",
        "fill_color",
        "color"
      ],
      "title": "PointProperties",
      "type": "object"
    },
    "PointShapeEnum": {
      "description": "Valid shapes for point markers",
      "enum": [
        "circle",
        "square",
        "triangle",
        "diamond",
        "cross"
      ],
      "title": "PointShapeEnum",
      "type": "string"
    },
    "ReferenceLocationProperties": {
      "additionalProperties": false,
      "description": "Properties for a ReferenceLocation",
      "properties": {
        "description": {
          "description": "Additional description",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "POINT",
          "description": "Feature type discriminator"
        },
        "location_type": {
          "$ref": "#/$defs/LocationTypeEnum",
          "description": "Type of reference"
        },
        "name": {
          "description": "Reference location name",
          "type": "string"
        },
        "point_metadata": {
          "description": "Per-point metadata array, parallel to MultiPoint coordinates. Each entry contains at minimum an index and name. Downstream tools extend entries with zone/color fields.",
          "items": {
            "$ref": "#/$defs/PointMetadataEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "provenance": {
          "description": "PROV-aligned provenance records (append-only log of tool operations)",
          "items": {
            "$ref": "#/$defs/LogEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/PointProperties",
          "description": "Point styling properties for display"
        },
        "symbol": {
          "description": "Map symbol identifier",
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "description": "Free-text labels assigned to this feature by the analyst",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "valid_from": {
          "description": "Start of validity period",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "description": "End of validity period",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "location_type",
        "style"
      ],
      "title": "ReferenceLocationProperties",
      "type": "object"
    },
    "TuneAnnotation": {
      "additionalProperties": false,
      "description": "Records a parameter modification (appended, not replacing original).",
      "properties": {
        "new_value": {
          "description": "Value after tuning.",
          "type": "string"
        },
        "parameter": {
          "description": "Name of the parameter that was changed.",
          "type": "string"
        },
        "previous_value": {
          "description": "Value before tuning.",
          "type": "string"
        },
        "timestamp": {
          "description": "When the tuning occurred (ISO 8601 with timezone).",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "parameter",
        "previous_value",
        "new_value"
      ],
      "title": "TuneAnnotation",
      "type": "object"
    },
    "WasGeneratedBy": {
      "additionalProperties": false,
      "description": "Identifies the tool and its parameters for a specific invocation. Named after the W3C PROV vocabulary term.",
      "properties": {
        "parameters": {
          "description": "Full resolved parameter set. Keys are parameter names, values are ParameterValue objects. May be empty dict.",
          "items": {
            "$ref": "#/$defs/ParameterValue"
          },
          "type": "array"
        },
        "tool": {
          "description": "Tool identifier (kebab-case, e.g., calculate-range).",
          "type": "string"
        },
        "tool_version": {
          "description": "Semantic version of the tool (e.g., 1.2.0).",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "parameters"
      ],
      "title": "WasGeneratedBy",
      "type": "object"
    }
  }
}