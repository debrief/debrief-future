{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://debrief.info/schemas/ReferenceLocation",
  "additionalProperties": false,
  "description": "GeoJSON Feature for fixed reference points",
  "properties": {
    "geometry": {
      "$ref": "#/$defs/GeoJSONPoint",
      "description": "Location (Point) or area (Polygon)"
    },
    "id": {
      "description": "Unique identifier",
      "type": "string"
    },
    "properties": {
      "$ref": "#/$defs/ReferenceLocationProperties",
      "description": "Reference metadata"
    },
    "type": {
      "const": "Feature",
      "description": "GeoJSON type discriminator",
      "type": "string"
    }
  },
  "required": [
    "type",
    "id",
    "geometry",
    "properties"
  ],
  "title": "ReferenceLocation",
  "type": "object",
  "$defs": {
    "CircleAnnotation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for circle annotations. Geometry is a Polygon approximating the circle (vertices at regular intervals). Properties contain center and radius for precise reconstruction and smooth rendering.",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONPolygon",
          "description": "Circle as Polygon (approximated with vertices, e.g., every 45 degrees)"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/CircleAnnotationProperties",
          "description": "Circle metadata including center and radius for reconstruction"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "CircleAnnotation",
      "type": "object"
    },
    "CircleAnnotationProperties": {
      "additionalProperties": false,
      "description": "Properties for a CircleAnnotation",
      "properties": {
        "center": {
          "description": "Circle center as [longitude, latitude] for precise reconstruction",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "CIRCLE",
          "description": "Feature type discriminator"
        },
        "label": {
          "description": "Annotation label text",
          "type": [
            "string",
            "null"
          ]
        },
        "radius": {
          "description": "Circle radius in meters for precise reconstruction",
          "minimum": 0,
          "type": "number"
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/PolygonProperties",
          "description": "Polygon styling properties for the circle area"
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "center",
        "radius",
        "style"
      ],
      "title": "CircleAnnotationProperties",
      "type": "object"
    },
    "FeatureKindEnum": {
      "description": "Discriminator for GeoJSON feature types",
      "enum": [
        "TRACK",
        "POINT",
        "NARRATIVE",
        "CIRCLE",
        "RECTANGLE",
        "LINE",
        "TEXT",
        "VECTOR",
        "SYSTEM"
      ],
      "title": "FeatureKindEnum",
      "type": "string"
    },
    "GeoJSONEmptyPoint": {
      "additionalProperties": false,
      "description": "GeoJSON Point geometry with empty coordinates (for non-spatial features)",
      "properties": {
        "coordinates": {
          "description": "Empty array for non-spatial features",
          "items": {
            "type": "number"
          },
          "maxItems": 0,
          "type": "array"
        },
        "type": {
          "const": "Point",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONEmptyPoint",
      "type": "object"
    },
    "GeoJSONLineString": {
      "additionalProperties": false,
      "description": "GeoJSON LineString geometry",
      "properties": {
        "coordinates": {
          "description": "Array of [longitude, latitude] pairs",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "type": {
          "const": "LineString",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONLineString",
      "type": "object"
    },
    "GeoJSONPoint": {
      "additionalProperties": false,
      "description": "GeoJSON Point geometry",
      "properties": {
        "coordinates": {
          "description": "[longitude, latitude] in degrees",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "type": {
          "const": "Point",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONPoint",
      "type": "object"
    },
    "GeoJSONPolygon": {
      "additionalProperties": false,
      "description": "GeoJSON Polygon geometry",
      "properties": {
        "coordinates": {
          "description": "Array of linear rings (arrays of [lon, lat] pairs)",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "type": {
          "const": "Polygon",
          "description": "Geometry type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "GeoJSONPolygon",
      "type": "object"
    },
    "LineAnnotation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for line segment annotations. Geometry is a LineString with 2 points (start and end).",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONLineString",
          "description": "Line as LineString (2 points)"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/LineAnnotationProperties",
          "description": "Line metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "LineAnnotation",
      "type": "object"
    },
    "LineAnnotationProperties": {
      "additionalProperties": false,
      "description": "Properties for a LineAnnotation",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "LINE",
          "description": "Feature type discriminator"
        },
        "label": {
          "description": "Annotation label text",
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/LineProperties",
          "description": "Line styling properties for the line segment"
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "style"
      ],
      "title": "LineAnnotationProperties",
      "type": "object"
    },
    "LineCapEnum": {
      "description": "How line endpoints are rendered (SVG/CSS standard)",
      "enum": [
        "butt",
        "round",
        "square"
      ],
      "title": "LineCapEnum",
      "type": "string"
    },
    "LineJoinEnum": {
      "description": "How line segment joints are rendered (SVG/CSS standard)",
      "enum": [
        "miter",
        "round",
        "bevel"
      ],
      "title": "LineJoinEnum",
      "type": "string"
    },
    "LineProperties": {
      "additionalProperties": false,
      "description": "Styling schema for LineString and MultiLineString geometries. Follows Leaflet Polyline options naming conventions.",
      "properties": {
        "color": {
          "description": "Line color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "dash_array": {
          "description": "Dash pattern (SVG format, e.g., \"5, 10\")",
          "type": [
            "string",
            "null"
          ]
        },
        "line_cap": {
          "$ref": "#/$defs/LineCapEnum",
          "description": "Line endpoint style"
        },
        "line_join": {
          "$ref": "#/$defs/LineJoinEnum",
          "description": "Line join style"
        },
        "opacity": {
          "description": "Line transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "stroke": {
          "description": "Whether to draw the line",
          "type": [
            "boolean",
            "null"
          ]
        },
        "weight": {
          "description": "Line width in pixels",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "color"
      ],
      "title": "LineProperties",
      "type": "object"
    },
    "LocationTypeEnum": {
      "description": "Type of reference location",
      "enum": [
        "WAYPOINT",
        "EXERCISE_AREA",
        "DANGER_AREA",
        "ANCHORAGE",
        "PORT",
        "REFERENCE"
      ],
      "title": "LocationTypeEnum",
      "type": "string"
    },
    "NarrativeEntry": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for timestamped narrative/log entries. Narratives are operator notes associated with a timestamp and optionally a track. Geometry is optional (Point for display position, or null).",
      "properties": {
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoJSONPoint"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional display position (Point) or null"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/NarrativeEntryProperties",
          "description": "Narrative metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "properties"
      ],
      "title": "NarrativeEntry",
      "type": "object"
    },
    "NarrativeEntryProperties": {
      "additionalProperties": false,
      "description": "Properties for a NarrativeEntry annotation",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "NARRATIVE",
          "description": "Feature type discriminator"
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/PointProperties",
          "description": "Point styling properties for display position"
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "Narrative text content",
          "type": "string"
        },
        "time": {
          "description": "Narrative timestamp (ISO8601)",
          "format": "date-time",
          "type": "string"
        },
        "track_id": {
          "description": "Associated track identifier (optional)",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "time",
        "text",
        "style"
      ],
      "title": "NarrativeEntryProperties",
      "type": "object"
    },
    "PointProperties": {
      "additionalProperties": false,
      "description": "Styling schema for Point and MultiPoint geometries. Follows Leaflet CircleMarker options naming conventions.",
      "properties": {
        "color": {
          "description": "Stroke color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "fill": {
          "description": "Whether to fill the shape",
          "type": [
            "boolean",
            "null"
          ]
        },
        "fill_color": {
          "description": "Fill color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "fill_opacity": {
          "description": "Fill transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "legacy_style": {
          "description": "Legacy symbol name from Debrief symbology (e.g., 'Aircraft', 'torpedo'). Preserved for future icon rendering support.",
          "type": [
            "string",
            "null"
          ]
        },
        "opacity": {
          "description": "Stroke transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "radius": {
          "description": "Marker radius in pixels",
          "minimum": 0,
          "type": "number"
        },
        "shape": {
          "$ref": "#/$defs/PointShapeEnum",
          "description": "Marker shape"
        },
        "stroke": {
          "description": "Whether to draw outline",
          "type": [
            "boolean",
            "null"
          ]
        },
        "weight": {
          "description": "Stroke width in pixels",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "shape",
        "radius",
        "fill_color",
        "color"
      ],
      "title": "PointProperties",
      "type": "object"
    },
    "PointShapeEnum": {
      "description": "Valid shapes for point markers",
      "enum": [
        "circle",
        "square",
        "triangle"
      ],
      "title": "PointShapeEnum",
      "type": "string"
    },
    "PolygonProperties": {
      "additionalProperties": false,
      "description": "Styling schema for Polygon and MultiPolygon geometries. Follows Leaflet Polygon options naming conventions.",
      "properties": {
        "color": {
          "description": "Border color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "dash_array": {
          "description": "Border dash pattern (SVG format, e.g., \"5, 10\")",
          "type": [
            "string",
            "null"
          ]
        },
        "fill": {
          "description": "Whether to fill the polygon",
          "type": [
            "boolean",
            "null"
          ]
        },
        "fill_color": {
          "description": "Fill color (CSS color string)",
          "pattern": "^(#[0-9A-Fa-f]{3,8}|[a-zA-Z]+|rgb\\(.+\\)|rgba\\(.+\\)|hsl\\(.+\\)|hsla\\(.+\\))$",
          "type": "string"
        },
        "fill_opacity": {
          "description": "Fill transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "line_cap": {
          "$ref": "#/$defs/LineCapEnum",
          "description": "Border endpoint style"
        },
        "line_join": {
          "$ref": "#/$defs/LineJoinEnum",
          "description": "Border join style"
        },
        "opacity": {
          "description": "Border transparency (0-1)",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "stroke": {
          "description": "Whether to draw border",
          "type": [
            "boolean",
            "null"
          ]
        },
        "weight": {
          "description": "Border width in pixels",
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "fill_color",
        "color"
      ],
      "title": "PolygonProperties",
      "type": "object"
    },
    "RectangleAnnotation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for rectangle annotations. Geometry is a Polygon with 4 corners (plus closing point).",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONPolygon",
          "description": "Rectangle as Polygon (4 corners + close)"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/RectangleAnnotationProperties",
          "description": "Rectangle metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "RectangleAnnotation",
      "type": "object"
    },
    "RectangleAnnotationProperties": {
      "additionalProperties": false,
      "description": "Properties for a RectangleAnnotation",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "RECTANGLE",
          "description": "Feature type discriminator"
        },
        "label": {
          "description": "Annotation label text",
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "description": "Original source file path",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "$ref": "#/$defs/PolygonProperties",
          "description": "Polygon styling properties for the rectangle area"
        },
        "symbol": {
          "description": "Display symbol code from REP file",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "style"
      ],
      "title": "RectangleAnnotationProperties",
      "type": "object"
    },
    "ReferenceLocation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for fixed reference points",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONPoint",
          "description": "Location (Point) or area (Polygon)"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/ReferenceLocationProperties",
          "description": "Reference metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "ReferenceLocation",
      "type": "object"
    },
    "ReferenceLocationProperties": {
      "additionalProperties": false,
      "description": "Properties for a ReferenceLocation",
      "properties": {
        "description": {
          "description": "Additional description",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "POINT",
          "description": "Feature type discriminator"
        },
        "location_type": {
          "$ref": "#/$defs/LocationTypeEnum",
          "description": "Type of reference"
        },
        "name": {
          "description": "Reference location name",
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/PointProperties",
          "description": "Point styling properties for display"
        },
        "symbol": {
          "description": "Map symbol identifier",
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "description": "Start of validity period",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "description": "End of validity period",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "location_type",
        "style"
      ],
      "title": "ReferenceLocationProperties",
      "type": "object"
    },
    "SystemState": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for storing non-spatial system state",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONEmptyPoint",
          "description": "Point geometry with empty coordinates for SYSTEM features"
        },
        "id": {
          "description": "State identifier (must start with 'state.')",
          "pattern": "^state\\.[a-z]+$",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/SystemStateProperties",
          "description": "State-specific properties"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "title": "SystemState",
      "type": "object"
    },
    "SystemStateProperties": {
      "additionalProperties": false,
      "description": "Properties for SYSTEM features storing application state",
      "properties": {
        "bbox": {
          "description": "Bounding box [minLon, minLat, maxLon, maxLat] - for spatial state",
          "items": {
            "type": "number"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "center": {
          "description": "Map center [longitude, latitude] - for spatial state",
          "items": {
            "type": "number"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "end_time": {
          "description": "Viewport end time (ISO8601) - for temporal state",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FeatureKindEnum",
          "const": "SYSTEM",
          "description": "Feature type discriminator"
        },
        "selected_ids": {
          "description": "Array of selected feature IDs - for selection state",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "start_time": {
          "description": "Viewport start time (ISO8601) - for temporal state",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "state_type": {
          "$ref": "#/$defs/SystemStateTypeEnum",
          "description": "Discriminator for state variant (temporal, spatial, selection)"
        },
        "zoom": {
          "description": "Map zoom level - for spatial state",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "state_type"
      ],
      "title": "SystemStateProperties",
      "type": "object"
    },
    "SystemStateTypeEnum": {
      "description": "Discriminator for system state variants",
      "enum": [
        "temporal",
        "spatial",
        "selection"
      ],
      "title": "SystemStateTypeEnum",
      "type": "string"
    },
    "TextAnnotation": {
      "additionalProperties": false,
      "description": "GeoJSON Feature for text annotations at a position. Geometry is the Point where text should be displayed.",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONPoint",
          "description": "Text display position"
        },
        "id": {
          "description": "Unique identifier",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/TextAnnotationProperties",
          "description": "Text metadata"
        },
        "type": {
          "const": "Feature",
          "description": "GeoJSON type discriminator",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
