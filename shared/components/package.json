{
  "name": "@debrief/components",
  "version": "0.1.0",
  "description": "Shared React components for Debrief maritime tactical analysis",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./MapView": {
      "types": "./dist/MapView/index.d.ts",
      "import": "./dist/MapView/index.js"
    },
    "./Timeline": {
      "types": "./dist/Timeline/index.d.ts",
      "import": "./dist/Timeline/index.js"
    },
    "./FeatureList": {
      "types": "./dist/FeatureList/index.d.ts",
      "import": "./dist/FeatureList/index.js"
    },
    "./ThemeProvider": {
      "types": "./dist/ThemeProvider/index.d.ts",
      "import": "./dist/ThemeProvider/index.js"
    },
    "./ToolMatch": {
      "types": "./dist/ToolMatch/index.d.ts",
      "import": "./dist/ToolMatch/index.js"
    },
    "./ChartRenderer": {
      "types": "./dist/ChartRenderer/index.d.ts",
      "import": "./dist/ChartRenderer/index.js"
    },
    "./filter-engine": {
      "types": "./dist/filter-engine/index.d.ts",
      "import": "./dist/filter-engine/index.js"
    },
    "./FilterBar": {
      "types": "./dist/FilterBar/index.d.ts",
      "import": "./dist/FilterBar/index.js"
    },
    "./colour-engine": {
      "types": "./dist/colour-engine/index.d.ts",
      "import": "./dist/colour-engine/index.js"
    },
    "./PropertiesPanel/provenanceTypes": {
      "types": "./src/PropertiesPanel/provenanceTypes.ts",
      "import": "./src/PropertiesPanel/provenanceTypes.ts"
    },
    "./PropertiesPanel/autoDerivedFields": {
      "types": "./src/PropertiesPanel/autoDerivedFields.ts",
      "import": "./src/PropertiesPanel/autoDerivedFields.ts"
    },
    "./nl-cql2-node": {
      "types": "./src/nl-cql2/node.ts",
      "import": "./src/nl-cql2/node.ts"
    },
    "./hooks/useIsMobile": {
      "types": "./src/hooks/useIsMobile.ts",
      "import": "./src/hooks/useIsMobile.ts"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/leaflet-geoman*"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bench": "vitest bench --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:claude": "CLAUDE_CODE=1 playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:fixtures": "cd ../../services/io && uv run python scripts/generate-storybook-fixtures.py"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@debrief/schemas": "workspace:*",
    "@debrief/utils": "workspace:*",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@geoman-io/leaflet-geoman-free": "^2.19.2",
    "@tanstack/react-virtual": "^3.0.0",
    "cql2-filters-parser": "^0.9.14",
    "golden-layout": "^2.6.0",
    "leaflet": "^1.9.0",
    "react-leaflet": "^4.2.1",
    "vega": "^5.30.0",
    "vega-embed": "^6.26.0",
    "vega-lite": "^5.21.0",
    "vscrui": "^0.1.0",
    "modern-screenshot": "^4.5.0",
    "immer": "^10.1.3",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@playwright/test": "^1.58.0",
    "@sparticuz/chromium": "^143.0.4",
    "@storybook/addon-a11y": "^8.4.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-interactions": "^8.4.0",
    "@storybook/addon-links": "^8.4.0",
    "@storybook/blocks": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@storybook/test": "^8.4.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.0.0",
    "memfs": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^8.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-css-injected-by-js": "^3.3.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "debrief",
    "react",
    "components",
    "maritime",
    "geojson",
    "leaflet",
    "timeline"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
