{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debrief.github.io/schemas/repo-review-ledger.schema.json",
  "title": "Repo Review Findings Ledger",
  "description": "Persistent findings ledger for the /repo-review skill (spec 282). Loaded from docs/project_notes/reviews/ledger.yaml via yaml.safe_load and validated against this schema before any read or write completes (FR-008).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "next_id", "findings"],
  "properties": {
    "version": { "const": 1 },
    "next_id": { "type": "integer", "minimum": 1 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/ledgerEntry" }
    }
  },
  "$defs": {
    "ledgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "status", "dimension", "severity", "effort", "title",
        "failure_scenario", "locations", "module_path", "defect_slug",
        "heuristic", "verification", "first_seen", "last_seen"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^RR-\\d{3,}$" },
        "status": { "enum": ["open", "fixed", "accepted-risk"] },
        "status_reason": { "type": "string", "minLength": 1 },
        "dimension": { "enum": ["constitution", "correctness", "tech-debt", "test-quality"] },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "effort": { "enum": ["S", "M", "L"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "failure_scenario": { "type": "string", "minLength": 1 },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/location" }
        },
        "module_path": { "type": "string", "minLength": 1 },
        "defect_slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "heuristic": { "type": "string", "pattern": "^(CC|CB|TD|TQ)-\\d+$|^\\(unprompted\\)$" },
        "verification": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "first_seen": { "$ref": "#/$defs/runRef" },
        "last_seen": { "$ref": "#/$defs/runRef" },
        "fix_pr": { "type": "string", "pattern": "^https://github\\.com/.+/pull/\\d+$" }
      },
      "if": { "properties": { "status": { "const": "accepted-risk" } } },
      "then": { "required": ["status_reason"] }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "runRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "git_sha"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
