# apps/nl-demo/.env.example
#
# Copy to apps/nl-demo/.env (gitignored) and fill in a real key.
# Only the proxy sidecar (scripts/live-proxy.mjs) reads this file.
# The browser bundle never sees these values.
#
# See specs/190-live-llm-transport/quickstart.md for full instructions.

# REQUIRED for live mode. Obtain from https://console.anthropic.com/settings/keys
# Placeholder only — replace with a real key in your local .env (never commit).
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Optional overrides — defaults match the quickstart examples.

# Anthropic Messages API endpoint. Override for staging or a compatible gateway.
# ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages

# Model identifier. Must match the value in live-config.json.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Anthropic API version header.
# ANTHROPIC_VERSION=2023-06-01

# Proxy bind. Default loopback-only. Non-loopback bind additionally requires
# PROXY_ALLOW_REMOTE=true and forces X-Proxy-Token auth on every request.
# PROXY_PORT=8081
# PROXY_BIND=127.0.0.1
# PROXY_ALLOW_REMOTE=false

# Upstream-response size cap (bytes). 2× the browser default, defence-in-depth.
# MAX_PROVIDER_BYTES=524288

# Proxy-side timeout (ms). Belt-and-braces; browser AbortController normally fires first.
# PROVIDER_TIMEOUT_MS=20000
