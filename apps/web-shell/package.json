{
  "name": "@debrief/web-shell",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "playwright test --config=playwright/playwright.config.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "playwright test --config=playwright/playwright.config.ts --ui",
    "test:cloud": "node run-playwright.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "generate-thumbnails": "npx tsx scripts/generate-thumbnails.ts"
  },
  "dependencies": {
    "@debrief/components": "workspace:*",
    "@debrief/session-state": "workspace:*",
    "@debrief/utils": "workspace:*",
    "golden-layout": "^2.6.0",
    "leaflet": "^1.9.4",
    "memfs": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shared-zustand": "^2.1.0",
    "ulid": "^3.0.2",
    "vscrui": "^0.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@playwright/test": "^1.58.0",
    "sharp": "^0.33.0",
    "@sparticuz/chromium": "^143.0.4",
    "@types/geojson": "^7946.0.0",
    "@types/leaflet": "^1.9.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
