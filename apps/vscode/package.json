{
  "name": "debrief-vscode",
  "displayName": "Debrief Maritime Analysis",
  "description": "Maritime tactical analysis extension for VS Code - browse STAC catalogs, display plots on maps, and run analysis tools",
  "version": "0.1.0",
  "publisher": "debrief",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "maritime",
    "analysis",
    "STAC",
    "GeoJSON",
    "maps"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/debrief/debrief-future.git",
    "directory": "apps/vscode"
  },
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:stac",
    "onView:debrief.stacExplorer",
    "onCommand:debrief.openPlot"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "debrief.nlSearch.setApiKey",
        "title": "NL Search — Set Anthropic API Key",
        "category": "Debrief"
      },
      {
        "command": "debrief.nlSearch.clearApiKey",
        "title": "NL Search — Clear Anthropic API Key",
        "category": "Debrief"
      },
      {
        "command": "debrief.openPlot",
        "title": "Open Plot",
        "category": "Debrief",
        "icon": "$(folder-opened)"
      },
      {
        "command": "debrief.closePlot",
        "title": "Close Plot",
        "category": "Debrief"
      },
      {
        "command": "debrief.addStore",
        "title": "Add STAC Store",
        "category": "Debrief",
        "icon": "$(add)"
      },
      {
        "command": "debrief.removeStore",
        "title": "Remove Store",
        "category": "Debrief",
        "icon": "$(trash)"
      },
      {
        "command": "debrief.refreshStore",
        "title": "Refresh",
        "category": "Debrief",
        "icon": "$(refresh)"
      },
      {
        "command": "debrief.selectAll",
        "title": "Select All Tracks",
        "category": "Debrief"
      },
      {
        "command": "debrief.clearSelection",
        "title": "Clear Selection",
        "category": "Debrief"
      },
      {
        "command": "debrief.fitToAll",
        "title": "Fit to All Tracks",
        "category": "Debrief",
        "icon": "$(screen-full)"
      },
      {
        "command": "debrief.fitToSelection",
        "title": "Fit to Selection",
        "category": "Debrief"
      },
      {
        "command": "debrief.zoomIn",
        "title": "Zoom In",
        "category": "Debrief",
        "icon": "$(zoom-in)"
      },
      {
        "command": "debrief.zoomOut",
        "title": "Zoom Out",
        "category": "Debrief",
        "icon": "$(zoom-out)"
      },
      {
        "command": "debrief.exportPng",
        "title": "Export as PNG",
        "category": "Debrief",
        "icon": "$(export)"
      },
      {
        "command": "debrief.executeTool",
        "title": "Execute Tool",
        "category": "Debrief"
      },
      {
        "command": "debrief.cancelToolExecution",
        "title": "Cancel",
        "category": "Debrief"
      },
      {
        "command": "debrief.toggleLayerVisibility",
        "title": "Toggle Visibility",
        "category": "Debrief"
      },
      {
        "command": "debrief.removeResultLayer",
        "title": "Remove Layer",
        "category": "Debrief"
      },
      {
        "command": "debrief.clearAllResults",
        "title": "Clear All Results",
        "category": "Debrief"
      },
      {
        "command": "debrief.changeTrackColor",
        "title": "Change Color",
        "category": "Debrief"
      },
      {
        "command": "debrief.setTimeRange",
        "title": "Set Time Range",
        "category": "Debrief"
      },
      {
        "command": "debrief.resetTimeRange",
        "title": "Full Range",
        "category": "Debrief"
      },
      {
        "command": "debrief.updateStorePath",
        "title": "Update Path",
        "category": "Debrief"
      },
      {
        "command": "debrief.restoreActivities",
        "title": "Restore Default Activities",
        "category": "Debrief"
      },
      {
        "command": "debrief.importRep",
        "title": "Load into Debrief...",
        "category": "Debrief",
        "icon": "$(file-add)"
      },
      {
        "command": "debrief.setDisplayMode",
        "title": "Set Display Mode",
        "category": "Debrief"
      },
      {
        "command": "debrief.undo",
        "title": "Undo",
        "category": "Debrief",
        "icon": "$(discard)"
      },
      {
        "command": "debrief.redo",
        "title": "Redo",
        "category": "Debrief",
        "icon": "$(redo)"
      },
      {
        "command": "debrief.saveSession",
        "title": "Save Session",
        "category": "Debrief",
        "icon": "$(save)"
      },
      {
        "command": "debrief.showToolRequirements",
        "title": "Show Tool Requirements",
        "category": "Debrief"
      },
      {
        "command": "debrief.toggleInactiveTools",
        "title": "Toggle Inactive Tools",
        "category": "Debrief",
        "icon": "$(filter)"
      },
      {
        "command": "debrief.deleteSelection",
        "title": "Delete Selected Features",
        "category": "Debrief",
        "icon": "$(trash)"
      },
      {
        "command": "debrief.tool.rangeBearing",
        "title": "Debrief: Range & Bearing",
        "enablement": "debrief.tool.range-bearing.active"
      },
      {
        "command": "debrief.__test.runExerciseAlphaRangeBearing",
        "title": "Debrief (test): Run Exercise Alpha Range-Bearing",
        "category": "Debrief Test"
      },
      {
        "command": "debrief.tool.closestApproach",
        "title": "Debrief: Closest Point of Approach",
        "enablement": "debrief.tool.closest-approach.active"
      },
      {
        "command": "debrief.tool.relativeMotion",
        "title": "Debrief: Relative Motion Analysis",
        "enablement": "debrief.tool.relative-motion.active"
      },
      {
        "command": "debrief.tool.trackStats",
        "title": "Debrief: Track Statistics",
        "enablement": "debrief.tool.track-stats.active"
      },
      {
        "command": "debrief.tool.distanceToPoint",
        "title": "Debrief: Distance to Point",
        "enablement": "debrief.tool.distance-to-point.active"
      },
      {
        "command": "debrief.openResultArtifact",
        "title": "Open Result Artifact",
        "category": "Debrief",
        "icon": "$(file)"
      },
      {
        "command": "debrief.openCatalogOverview",
        "title": "Open Catalog Overview",
        "category": "Debrief",
        "icon": "$(map)"
      },
      {
        "command": "debrief.captureScene",
        "title": "Capture Scene to Storyboard",
        "category": "Debrief",
        "icon": "$(device-camera)"
      },
      {
        "command": "debrief.storyboard.forward",
        "title": "Storyboard: Forward",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.backward",
        "title": "Storyboard: Backward",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.clickScene",
        "title": "Storyboard: Select Scene",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.jumpPast",
        "title": "Storyboard: Jump Past Blocked Scene",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.create",
        "title": "Storyboard: Create New Storyboard",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.rename",
        "title": "Storyboard: Rename Storyboard",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.delete",
        "title": "Storyboard: Delete Storyboard",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.openPanel",
        "title": "Storyboard: Show Panel",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.renameScene",
        "title": "Storyboard: Rename Scene",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.describeScene",
        "title": "Storyboard: Edit Scene Description",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.deleteScene",
        "title": "Storyboard: Delete Scene",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.updateSceneToCurrent",
        "title": "Storyboard: Update Scene to Current",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.duplicateScene",
        "title": "Storyboard: Duplicate Scene",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.copySceneToOtherStoryboard",
        "title": "Storyboard: Copy Scene to Another Storyboard",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.refreshSceneThumbnail",
        "title": "Storyboard: Refresh Scene Thumbnail",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.refreshAllStaleThumbnails",
        "title": "Storyboard: Refresh All Stale Thumbnails",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.renameStoryboard",
        "title": "Storyboard: Rename Storyboard (via edit service)",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.describeStoryboard",
        "title": "Storyboard: Edit Storyboard Description",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.editScene",
        "title": "Storyboard: Open Scene for Editing",
        "category": "Debrief"
      },
      {
        "command": "debrief.storyboard.exportAsBriefingZip",
        "title": "Storyboard: Export Storyboard as briefing zip…",
        "category": "Debrief"
      }
    ],
    "keybindings": [
      {
        "command": "debrief.selectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "debrief.mapFocused"
      },
      {
        "command": "debrief.clearSelection",
        "key": "escape",
        "when": "debrief.mapFocused && debrief.hasSelection"
      },
      {
        "command": "debrief.clearSelection",
        "key": "delete",
        "when": "debrief.mapFocused && debrief.hasSelection"
      },
      {
        "command": "debrief.fitToAll",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "debrief.mapFocused"
      },
      {
        "command": "debrief.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "debrief.mapFocused"
      },
      {
        "command": "debrief.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "debrief.mapFocused"
      },
      {
        "command": "debrief.openPlot",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o"
      },
      {
        "command": "debrief.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "debrief.mapFocused"
      },
      {
        "command": "debrief.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "debrief.mapFocused"
      },
      {
        "command": "debrief.saveSession",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "debrief.mapFocused"
      },
      {
        "command": "debrief.deleteSelection",
        "key": "delete",
        "mac": "backspace",
        "when": "focusedView == 'debrief.activityPanel' && debrief.hasSelection"
      },
      {
        "command": "debrief.deleteSelection",
        "key": "delete",
        "mac": "delete",
        "when": "focusedView == 'debrief.activityPanel' && debrief.hasSelection"
      },
      {
        "command": "debrief.captureScene",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "debrief.mapFocused && debrief.plotOpen"
      },
      {
        "command": "debrief.storyboard.forward",
        "key": "right",
        "when": "debrief.storyboardActive && (debrief.mapFocused || focusedView == 'debrief.activityPanel')"
      },
      {
        "command": "debrief.storyboard.backward",
        "key": "left",
        "when": "debrief.storyboardActive && (debrief.mapFocused || focusedView == 'debrief.activityPanel')"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "debrief",
          "title": "Debrief",
          "icon": "resources/debrief-icon.svg"
        },
        {
          "id": "debrief-log",
          "title": "Debrief Log",
          "icon": "resources/log-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "debrief-results",
          "title": "Debrief Results",
          "icon": "resources/debrief-icon.svg"
        }
      ]
    },
    "views": {
      "debrief": [
        {
          "id": "debrief.activityPanel",
          "name": "Activity",
          "type": "webview"
        }
      ],
      "debrief-log": [
        {
          "id": "debrief.logPanel",
          "name": "Log",
          "type": "webview"
        }
      ],
      "debrief-results": [
        {
          "id": "debrief.resultsPanel",
          "name": "Results",
          "type": "webview"
        }
      ],
      "explorer": [
        {
          "id": "debrief.stacExplorer",
          "name": "STAC Stores"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "debrief.stacExplorer",
        "contents": "Loading stores…",
        "when": "!debrief.storesReady"
      },
      {
        "view": "debrief.stacExplorer",
        "contents": "No STAC stores configured.\n[Add Store](command:debrief.addStore)\nA STAC store is a folder containing maritime plot data.",
        "when": "debrief.noStores"
      },
      {
        "view": "debrief.activityPanel",
        "contents": "No plot loaded.\n\nOpen a plot to see time controls, layers, and available analysis tools."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "debrief.importRep",
          "when": "resourceExtname == .rep",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "debrief.addStore",
          "when": "view == debrief.stacExplorer",
          "group": "navigation"
        },
        {
          "command": "debrief.clearAllResults",
          "when": "view == debrief.activityPanel && debrief.hasResultLayers"
        },
        {
          "command": "debrief.toggleInactiveTools",
          "when": "view == debrief.activityPanel && debrief.calcAvailable",
          "group": "navigation"
        },
        {
          "command": "debrief.captureScene",
          "when": "view == debrief.activityPanel && debrief.mapFocused && debrief.plotOpen",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "debrief.removeStore",
          "when": "view == debrief.stacExplorer && viewItem =~ /^store/",
          "group": "3_modify"
        },
        {
          "command": "debrief.refreshStore",
          "when": "view == debrief.stacExplorer && viewItem == store",
          "group": "1_navigation"
        },
        {
          "command": "debrief.updateStorePath",
          "when": "view == debrief.stacExplorer && viewItem == storeInvalid",
          "group": "3_modify"
        },
        {
          "command": "debrief.openCatalogOverview",
          "when": "view == debrief.stacExplorer && viewItem == catalog",
          "group": "1_navigation"
        },
        {
          "command": "debrief.openPlot",
          "when": "view == debrief.stacExplorer && viewItem == plot",
          "group": "1_navigation"
        },
        {
          "command": "debrief.removeResultLayer",
          "when": "view == debrief.activityPanel && viewItem == resultLayer",
          "group": "3_modify"
        },
        {
          "command": "debrief.removeResultLayer",
          "when": "view == debrief.activityPanel && viewItem == artifactResultLayer",
          "group": "3_modify"
        },
        {
          "command": "debrief.openResultArtifact",
          "when": "view == debrief.activityPanel && viewItem == artifactResultLayer",
          "group": "1_navigation"
        },
        {
          "command": "debrief.changeTrackColor",
          "when": "view == debrief.activityPanel && viewItem == track",
          "group": "2_style"
        },
        {
          "command": "debrief.executeTool",
          "when": "view == debrief.activityPanel && viewItem == tool.active",
          "group": "1_execute"
        }
      ],
      "commandPalette": [
        {
          "command": "debrief.closePlot",
          "when": "debrief.plotOpen"
        },
        {
          "command": "debrief.selectAll",
          "when": "debrief.plotOpen"
        },
        {
          "command": "debrief.clearSelection",
          "when": "debrief.plotOpen && debrief.hasSelection"
        },
        {
          "command": "debrief.fitToAll",
          "when": "debrief.plotOpen"
        },
        {
          "command": "debrief.fitToSelection",
          "when": "debrief.plotOpen && debrief.hasSelection"
        },
        {
          "command": "debrief.exportPng",
          "when": "debrief.plotOpen"
        },
        {
          "command": "debrief.deleteSelection",
          "when": "debrief.plotOpen && debrief.hasSelection"
        },
        {
          "command": "debrief.captureScene",
          "when": "debrief.plotOpen"
        },
        {
          "command": "debrief.storyboard.clickScene",
          "when": "false"
        },
        {
          "command": "debrief.storyboard.jumpPast",
          "when": "false"
        },
        {
          "command": "debrief.storyboard.forward",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.backward",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.renameScene",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.describeScene",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.deleteScene",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.updateSceneToCurrent",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.duplicateScene",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.copySceneToOtherStoryboard",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.refreshSceneThumbnail",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.refreshAllStaleThumbnails",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.renameStoryboard",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.describeStoryboard",
          "when": "debrief.storyboardActive"
        },
        {
          "command": "debrief.storyboard.editScene",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Debrief",
      "properties": {
        "debrief.copilot.activeModel": {
          "type": "string",
          "default": "unknown",
          "description": "Spike #284: operator-annotated model name recorded in Copilot tool telemetry (the LM Tools API does not expose the active model to the tool). Set this to the model you have selected in Copilot before a scenario run."
        },
        "debrief.copilot.primingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Spike #284: records in Copilot tool telemetry whether .github/copilot-instructions.md is active for the current run (FR-027 with/without-priming comparison). Set to false when running with the priming file renamed away."
        },
        "debrief.selection.glowEffect": {
          "type": "boolean",
          "default": true,
          "description": "Enable animated glow effect on selected tracks"
        },
        "debrief.logPanel.collapseConsecutiveSameOp": {
          "type": "boolean",
          "default": true,
          "description": "When 3+ consecutive storyboard edit entries share the same op + actor within a 120-second window, render them as a single collapsed card in the Analysis Log Panel. Turn off for full granularity."
        },
        "debrief.tracks.defaultColors": {
          "type": "array",
          "default": [
            "#e41a1c",
            "#377eb8",
            "#4daf4a",
            "#984ea3",
            "#ff7f00",
            "#ffff33",
            "#a65628",
            "#f781bf"
          ],
          "description": "Default color palette for tracks"
        },
        "debrief.map.renderer": {
          "type": "string",
          "enum": [
            "canvas",
            "svg"
          ],
          "default": "canvas",
          "description": "Map renderer (canvas recommended for performance)"
        },
        "debrief.calc.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python executable for debrief-calc. Leave empty to auto-detect from project .venv"
        },
        "debrief.calc.connectionTimeout": {
          "type": "number",
          "default": 5000,
          "description": "MCP connection timeout in milliseconds"
        },
        "debrief.recentPlots.maxCount": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of recent plots to remember"
        },
        "debrief.mcp.port": {
          "type": "number",
          "default": 3001,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port for the MCP session state server (used by Python tools)"
        },
        "debrief.hideActivities.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a one-time prompt about the focused activity bar configuration"
        },
        "debrief.nlSearch.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable natural-language search in the Catalog Overview. When on, typing a plain-English phrase routes through the configured language model. Default is off — plain literal title search runs with no network calls."
        },
        "debrief.nlSearch.model": {
          "type": "string",
          "default": "claude-haiku-4-5-20251001",
          "description": "Anthropic model ID used by NL search. Change only if you have access to a different model variant."
        },
        "debrief.nlSearch.callCeiling": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of NL-search calls per VS Code session. Prevents runaway spend; resets when the editor is reloaded."
        },
        "debrief.nlSearch.timeoutMs": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Per-call timeout in milliseconds. The NL-search call aborts if the provider has not responded by this deadline."
        },
        "debrief.nlSearch.maxResponseBytes": {
          "type": "number",
          "default": 262144,
          "minimum": 1024,
          "maximum": 10485760,
          "description": "Defensive cap on the provider's response size in bytes. Responses exceeding this budget are treated as a malformed response."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "debrief_searchPlots",
        "displayName": "Search Debrief plots",
        "modelDescription": "Search the local STAC catalog for plots by free text (title/description), time range, platform name/type, and/or spatial bounding box. Returns matching plots with id, title, time span, platforms, and extent. Optionally opens a single match in the Debrief plot editor.",
        "toolReferenceName": "debrief_searchPlots",
        "canBeReferencedInPrompt": true,
        "tags": [
          "debrief"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "Free-text matched against plot title and description."
            },
            "startTime": {
              "type": "string",
              "description": "ISO-8601 start of the time range to overlap."
            },
            "endTime": {
              "type": "string",
              "description": "ISO-8601 end of the time range to overlap."
            },
            "platforms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Platform names or types to match (membership)."
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "Spatial extent [west, south, east, north] to intersect."
            },
            "open": {
              "type": "boolean",
              "description": "When true and exactly one plot matches, open it in the editor."
            }
          }
        }
      },
      {
        "name": "debrief_summarizeCurrentPlot",
        "displayName": "Summarise current Debrief plot",
        "modelDescription": "Summarise the currently open Debrief plot: metadata plus a thinned inventory of its features (names, types, platforms, time spans, counts — no geometry). Use before targeting an edit. Accepts an optional plotId to summarise a specific open plot; also lists all open plots. Set selectionOnly to summarise only the currently selected features.",
        "toolReferenceName": "debrief_summarizeCurrentPlot",
        "canBeReferencedInPrompt": true,
        "tags": [
          "debrief"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "plotId": {
              "type": "string",
              "description": "Optional stac:// id of an open plot to summarise; defaults to the active plot."
            },
            "selectionOnly": {
              "type": "boolean",
              "description": "When true, summarise only the currently selected features."
            }
          }
        }
      },
      {
        "name": "debrief_listTools",
        "displayName": "List Debrief tools",
        "modelDescription": "List the Debrief analysis/editing tools available for the current plot and selection, with their parameters and whether each modifies the plot. Call before debrief_runTool to choose a tool and build valid parameters.",
        "toolReferenceName": "debrief_listTools",
        "canBeReferencedInPrompt": true,
        "tags": [
          "debrief"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "plotId": {
              "type": "string",
              "description": "Optional stac:// id of an open plot; defaults to the active plot."
            }
          }
        }
      },
      {
        "name": "debrief_runTool",
        "displayName": "Run a Debrief tool",
        "modelDescription": "Run a Debrief tool by id against the current plot. Tools that modify the plot require user confirmation; analytical tools return a summary and populate the Results panel. Pass the analyst's original request as `utterance` for provenance. Validate the tool id and parameters with debrief_listTools first.",
        "toolReferenceName": "debrief_runTool",
        "canBeReferencedInPrompt": true,
        "tags": [
          "debrief"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "toolId"
          ],
          "properties": {
            "toolId": {
              "type": "string",
              "description": "The registry id of the tool to run (from debrief_listTools)."
            },
            "params": {
              "type": "object",
              "description": "Parameter values for the tool, validated against its schema."
            },
            "plotId": {
              "type": "string",
              "description": "Optional stac:// id of an open plot to target; defaults to the active plot."
            },
            "scope": {
              "type": "string",
              "enum": [
                "all",
                "selection"
              ],
              "description": "Operate on all features or the current selection. Defaults to selection when features are selected, else all."
            },
            "utterance": {
              "type": "string",
              "description": "The analyst's original natural-language request, recorded in provenance."
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build": "pnpm --filter @debrief/components build && npm run compile && npm run sync-briefing-renderer",
    "compile": "npm run compile:extension && npm run compile:webview",
    "sync-briefing-renderer": "pnpm --filter @debrief/briefing-renderer build && cpy 'apps/briefing-renderer/dist/**' apps/vscode/resources/briefing-renderer-static --cwd ../..",
    "compile:extension": "node esbuild.config.js",
    "compile:webview": "esbuild src/webview/web/mapView.tsx --bundle --outfile=dist/webview/mapView.js --format=iife --loader:.tsx=tsx --loader:.css=text && esbuild src/webview/web/timeController.tsx --bundle --outfile=dist/webview/timeController.js --format=iife --loader:.tsx=tsx --loader:.css=text && esbuild src/webview/web/catalogOverview.tsx --bundle --outfile=dist/webview/catalogOverview.js --format=iife --loader:.tsx=tsx --loader:.css=text && esbuild src/webview/web/activityPanel.tsx --bundle --outfile=dist/webview/activityPanel.js --format=iife --loader:.tsx=tsx --loader:.css=text && esbuild src/webview/web/logPanel.tsx --bundle --outfile=dist/webview/logPanel.js --format=iife --loader:.tsx=tsx --loader:.css=text && esbuild src/webview/web/resultsPanel.tsx --bundle --outfile=dist/webview/resultsPanel.js --format=iife --loader:.tsx=tsx --loader:.css=text && cpy src/webview/web/styles.css dist/webview/",
    "watch": "npm run watch:extension & npm run watch:webview",
    "watch:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "watch:webview": "esbuild src/webview/web/mapView.tsx --bundle --outfile=dist/webview/mapView.js --format=iife --loader:.tsx=tsx --loader:.css=text --watch & esbuild src/webview/web/timeController.tsx --bundle --outfile=dist/webview/timeController.js --format=iife --loader:.tsx=tsx --loader:.css=text --watch & esbuild src/webview/web/catalogOverview.tsx --bundle --outfile=dist/webview/catalogOverview.js --format=iife --loader:.tsx=tsx --loader:.css=text --watch & esbuild src/webview/web/activityPanel.tsx --bundle --outfile=dist/webview/activityPanel.js --format=iife --loader:.tsx=tsx --loader:.css=text --watch & esbuild src/webview/web/logPanel.tsx --bundle --outfile=dist/webview/logPanel.js --format=iife --loader:.tsx=tsx --loader:.css=text --watch & esbuild src/webview/web/resultsPanel.tsx --bundle --outfile=dist/webview/resultsPanel.js --format=iife --loader:.tsx=tsx --loader:.css=text --watch",
    "dev": "concurrently \"npm run watch:extension\" \"npm run watch:webview\"",
    "prelint": "pnpm --filter @debrief/session-state build && pnpm --filter @debrief/utils build",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vscode-test",
    "test:e2e": "playwright test",
    "package": "vsce package --no-dependencies",
    "pretest": "npm run build"
  },
