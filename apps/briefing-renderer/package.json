{
  "name": "@debrief/briefing-renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Air-gapped briefing zip — standalone Storyboard renderer SPA (spec #264).",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/strip-crossorigin.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:cloud": "node run-playwright.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@debrief/components": "workspace:*",
    "@debrief/schemas": "workspace:*",
    "@debrief/session-state": "workspace:*",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sparticuz/chromium": "^143.0.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^14.0.0",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^28.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
